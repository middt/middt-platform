    private async Task RunPlaygroundAsync()
    {
        playgroundError = null;
        playgroundResult = null;
        if (!TrySyncVisualFieldsToModels(out var syncErr))
        {
            playgroundError = syncErr;
            return;
        }

        JsonObject? dataObj = null;
        if (!string.IsNullOrWhiteSpace(playgroundDataText))
        {
            try
            {
                dataObj = JsonNode.Parse(playgroundDataText) as JsonObject;
            }
            catch (Exception ex)
            {
                playgroundError = $"Örnek veri JSON formatı hatalı: {ex.Message}";
                return;
            }
        }

        playgroundBusy = true;
        try
        {
            var req = new AgentPlaygroundRequest
            {
                Agent = draftAgent.Name,
                Definition = draftAgent,
                Prompt = playgroundPrompt,
                Data = dataObj,
                AllowedTransitions = draftAgent.AllowedTransitions.Count > 0
                    ? draftAgent.AllowedTransitions
                    : ["route-auto-refund", "route-specialist-review", "route-fraud-investigation"],
            };

            var resp = await AgentClient.TestPlaygroundAsync(req);
            if (!resp.IsSuccess || resp.Data is null)
            {
                playgroundError = resp.ErrorText;
                return;
            }

            playgroundResult = resp.Data;
        }
        finally
        {
            playgroundBusy = false;
        }
    }

    private string GetCurrentItemTitle() => activeSection switch
    {
        "agents" => string.IsNullOrWhiteSpace(draftAgent.Name) ? "Yeni Ajan" : draftAgent.Name,
        "tools" => string.IsNullOrWhiteSpace(draftTool.Name) ? "Yeni Araç" : draftTool.Name,
        _ => string.IsNullOrWhiteSpace(draftMcp.Name) ? "Yeni MCP Sunucusu" : draftMcp.Name,
    };

    private static string FormatNode(JsonNode? node) =>
        node is null ? "null" : node.ToJsonString(IndentedJson);

    private static T CloneJson<T>(T source)
    {
        var json = JsonSerializer.Serialize(source, IndentedJson);
        return JsonSerializer.Deserialize<T>(json, IndentedJson)!;
    }
}

