                                <option value="success">success (Yeşil)</option>
                                <option value="warning">warning (Sarı)</option>
                                <option value="danger">danger (Kırmızı)</option>
                                <option value="secondary">secondary (Gri)</option>
                            </select>
                        </div>
                        <div class="middt-ui-input">
                            <label>Yetkili Roller (roles)</label>
                            <input class="middt-wf-input" value="@GetCsvArray(trObj, "roles")" placeholder="manager, $starter"
                                   @onchange="@(e => { SetCsvArray(trObj, "roles", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                        </div>
                    </div>
                }
                else if (trTrigger == "Automatic")
                {
                    <label class="middt-ui-check">
                        <input type="checkbox" checked="@GetBool(trObj, "default")"
                               @onchange="@(e => { SetBool(trObj, "default", e.Value is true); SyncJsonFromDoc(); })" />
                        <span>Varsayılan Dal (<code>default: true</code>)</span>
                    </label>
                }
                else if (trTrigger == "Scheduled")
                {
                    <div class="middt-ui-input">
                        <label>Bekleme Süresi (after)</label>
                        <input class="middt-wf-input" value="@GetString(trObj, "after")" placeholder="00:10:00 veya PT10M"
                               @onchange="@(e => { SetString(trObj, "after", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                    </div>
                }
                else if (trTrigger == "Event")
                {
                    <div class="middt-ui-input">
                        <label>Beklenen Olay Adı (event)</label>
                        <input class="middt-wf-input" value="@GetString(trObj, "event")" placeholder="PaymentCaptured"
                               @onchange="@(e => { SetString(trObj, "event", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                    </div>
                }

                <hr class="middt-ui-divider" />
                <h4 class="middt-ui-section-title">⚡ Geçiş Görevleri (onExecute: @trTasks.Count)</h4>
                <div class="middt-wf-dropzone"
                     @ondragover:preventDefault="true"
                     @ondrop="@(e => OnDropOntoTransitionBadge(e, selectedNodeKey, selectedTransitionIndex))">
                    @if (trTasks.Count == 0)
                    {
                        <div class="middt-wf-dropzone-empty">Sol paletten bir görevi buraya veya tuvaldeki geçiş okuna sürükleyin</div>
                    }
                    @for (var ti = 0; ti < trTasks.Count; ti++)
                    {
                        var taskIdx = ti;
                        if (trTasks[taskIdx] is JsonObject tObj)
                        {
                            <button type="button" class="middt-wf-task-pill"
                                    @onclick="@(() => SelectTransitionTask(selectedNodeKey, selectedTransitionIndex, taskIdx))">
                                <span>⚡ @TaskSummary(tObj)</span>
                                <small>@TaskBadges(tObj)</small>
                            </button>
                        }
                    }
                </div>
            </div>
            return;
        }

        @* 3. Selected State Node Inspector *@
        if (FindState(selectedNodeKey) is { } stateObj)
        {
            var stateKey = GetString(stateObj, "key") ?? string.Empty;
            var transitions = EnsureArray(stateObj, "transitions");

            <div class="middt-ui-form">
                <div class="middt-ui-toolbar" style="justify-content: space-between">
                    <div>
                        <span class="middt-ui-badge middt-ui-badge-primary">📍 Durum (State)</span>
                        <h3 class="middt-ui-section-title rz-mt-1">@(GetString(stateObj, "title") ?? stateKey)</h3>
                    </div>
                    <RadzenButton Icon="delete" Text="Durumu Sil" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                  Click="@(() => RemoveState(stateKey))" />
                </div>

                <div class="middt-wf-grid-2">
                    <div class="middt-ui-input">
                        <label>Durum Anahtarı (key)</label>
                        <input class="middt-wf-input" value="@stateKey"
                               @onchange="@(e => RenameState(stateObj, e.Value?.ToString()))" />
                    </div>
                    <div class="middt-ui-input">
                        <label>Durum Başlığı (title)</label>
                        <input class="middt-wf-input" value="@GetString(stateObj, "title")"
                               @onchange="@(e => { SetString(stateObj, "title", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                    </div>
                    <div class="middt-ui-input">
                        <label>Durum Tipi (type)</label>
                        <select class="middt-wf-input" value="@(GetString(stateObj, "type") ?? "Intermediate")"
                                @onchange="@(e => ChangeStateType(stateObj, e.Value?.ToString()))">
                            <option value="Initial">Initial</option>
                            <option value="Intermediate">Intermediate</option>
                            <option value="SubFlow">SubFlow</option>
                            <option value="Finish">Finish</option>
                        </select>
                    </div>
                    <div class="middt-ui-input">
                        <label>Alt Tip (subType)</label>
                        <select class="middt-wf-input" value="@(GetString(stateObj, "subType") ?? "None")"
                                @onchange="@(e => { SetString(stateObj, "subType", e.Value?.ToString()); SyncJsonFromDoc(); })">
                            <option value="None">None (Sistem / Otomatik)</option>
                            <option value="Human">Human (İnsan Görevi)</option>
                            <option value="Success">Success (Başarılı Sonuç)</option>
                            <option value="Error">Error (Red / Hata)</option>
                            <option value="Cancelled">Cancelled (İptal)</option>
                            <option value="Timeout">Timeout (Zaman Aşımı)</option>
                        </select>
                    </div>
                    <div class="middt-ui-input">
                        <label>İlerleme Çubuğu Adım Sırası (step)</label>
                        <input type="number" class="middt-wf-input" placeholder="Ör: 1, 2, 3" value="@(GetIntNullable(stateObj, "step")?.ToString(CultureInfo.InvariantCulture) ?? "")"
                               @onchange="@(e => { SetIntNullable(stateObj, "step", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                        <small class="middt-ui-text-muted">Kayıt detay ekranının üstündeki ilerleme çubuğunda (1 → 2 → 3) kaçıncı aşama olarak görüneceğini belirler. Boş bırakılırsa adım çubuğunda yer almaz.</small>
                    </div>
                    @if (GetString(stateObj, "type") != "SubFlow")
                    {
                        var curLayoutKey = GetNestedString(stateObj, "view", "layout") ?? string.Empty;
                        <div class="middt-ui-input">
                            <label>Ekran Yerleşimi (view.layout)</label>
                            <div class="middt-ui-picker">
                                <select class="middt-wf-input" value="@curLayoutKey"
                                        @onchange="@(e => { SetNestedString(stateObj, "view", "layout", e.Value?.ToString()); SyncJsonFromDoc(); })">
                                    <option value="">(Ekran seçilmedi — Varsayılan Şema Görünümü)</option>
                                    @foreach (var l in uiLayouts)
                                    {
                                        <option value="@l.Key">@l.Key (@(l.Title ?? l.Key) · @l.Kind)</option>
                                    }
                                    @if (!string.IsNullOrEmpty(curLayoutKey) && !uiLayouts.Any(l => string.Equals(l.Key, curLayoutKey, StringComparison.Ordinal)))
                                    {
                                        <option value="@curLayoutKey">@curLayoutKey (Yeni / Özel)</option>
                                    }
                                </select>
                                <input class="middt-wf-input" style="max-width: 140px" value="@curLayoutKey"
                                       placeholder="credit-review"
                                       @onchange="@(e => { SetNestedString(stateObj, "view", "layout", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                            </div>
                            <div class="middt-ui-toolbar" style="margin-top: .25rem">
                                @if (!string.IsNullOrWhiteSpace(curLayoutKey))
                                {
                                    <RadzenButton Icon="edit" Text="Ekranı Tasarla / Düzenle" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Info"
                                                  Click="@(() => OpenScreenDesignerForState(stateObj, curLayoutKey))" />
                                    <RadzenButton Icon="open_in_new" Text="Bağımsız Aç" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => NavigateToStandaloneScreenDesigner(curLayoutKey))" />
                                }
                                <RadzenButton Icon="auto_fix_high" Text="Yeni Ekran Oluştur & Bağla" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Secondary"
                                              Click="@(() => CreateAndBindNewScreenForState(stateObj))" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="middt-ui-input">
                            <label>Ekran Yerleşimi (Alt Akışтан Otomatik)</label>
                            <small class="middt-ui-text-muted">🔗 <strong>SubFlow</strong> durumlarında ayrı bir ekran tanımlanmaz; çalışma zamanında çağrılan alt akışın kendi aktif adım ekranı (<code>view.layout</code>) otomatik olarak gösterilir.</small>
                        </div>
                    }
                </div>

                @if (GetString(stateObj, "type") == "SubFlow")
                {
                    var subFlowObj = EnsureObject(stateObj, "subFlow");
                    var sfTarget = GetString(subFlowObj, "workflow") ?? string.Empty;
                    var sfInputObj = EnsureObject(subFlowObj, "input");
                    var sfForward = subFlowObj["forwardTransitions"] is null || GetBool(subFlowObj, "forwardTransitions");

                    <hr class="middt-ui-divider" />
                    <div class="middt-ui-toolbar" style="justify-content: space-between">
                        <h4 class="middt-ui-section-title">🔗 Alt Akış Ayarları (subFlow)</h4>
                        @if (!string.IsNullOrWhiteSpace(sfTarget))
                        {
                            <RadzenButton Icon="open_in_new" Text="@($"'{sfTarget}' Akışını Aç")" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Info"
                                          Click="@(() => OpenWorkflowAsync(sfTarget))" />
                        }
                    </div>

                    <div class="middt-wf-grid-2">
                        <div class="middt-ui-input">
                            <label>Çağrılacak Alt Akış (subFlow.workflow)</label>
                            <select class="middt-wf-input" value="@sfTarget"
                                    @onchange="@(e => { SetString(subFlowObj, "workflow", e.Value?.ToString()); SyncJsonFromDoc(); })">
                                <option value="">(Alt akış seçiniz)</option>
                                @foreach (var w in workflows.Where(w => !string.Equals(w.Key, GetString(doc, "key"), StringComparison.Ordinal)))
                                {
                                    <option value="@w.Key">@w.Key (@(w.Title ?? w.Key))</option>
                                }
                            </select>
                        </div>
                        <div class="middt-ui-input">
                            <label>Sonucun Yazılacağı Alan (subFlow.outputInto)</label>
                            <input class="middt-wf-input" value="@GetString(subFlowObj, "outputInto")"
                                   placeholder="Ör: riskResult (boşsa kök veriye birleştirir)"
                                   @onchange="@(e => { SetString(subFlowObj, "outputInto", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                        </div>
                    </div>

                    <label class="middt-ui-check">
                        <input type="checkbox" checked="@sfForward"
                               @onchange="@(e => { SetBool(subFlowObj, "forwardTransitions", e.Value is true); SyncJsonFromDoc(); })" />
                        <span>Alt akışın manuel geçiş butonlarını üst akış ekranından doğrudan tetiklemeye izin ver (<code>forwardTransitions: true</code>)</span>
                    </label>

                    <div class="middt-ui-toolbar" style="justify-content: space-between; margin-top: .35rem">
                        <label style="font-size: .78rem; font-weight: 600">Alt Akışa Gönderilecek Giriş Verileri (subFlow.input: @sfInputObj.Count)</label>
                        <RadzenButton Icon="add" Text="Parametre Ekle" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => AddSubFlowInputRow(sfInputObj))" />
                    </div>
                    <small class="middt-ui-text-muted">Boş bırakılırsa üst akışın tüm verisi alt akışa kopyalanır.</small>
                    @foreach (var kv in sfInputObj.ToList())
                    {
                        var paramKey = kv.Key;
                        var paramExpr = kv.Value?.ToString() ?? string.Empty;
                        <div class="middt-ui-picker">
                            <input class="middt-wf-input" style="max-width: 150px" value="@paramKey" placeholder="hedefAlan"
                                   @onchange="@(e => RenameSubFlowInputKey(sfInputObj, paramKey, e.Value?.ToString()))" />
                            <span>=</span>
                            <input class="middt-wf-input" style="flex: 1" value="@paramExpr" placeholder="data.customerKey"
                                   @onchange="@(e => { sfInputObj[paramKey] = e.Value?.ToString() ?? string.Empty; SyncJsonFromDoc(); })" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                          Click="@(() => { sfInputObj.Remove(paramKey); SyncJsonFromDoc(); })" />
                        </div>
                    }
                }

                @if (GetString(stateObj, "type") != "Finish")
                {
                    <hr class="middt-ui-divider" />
                    <div class="middt-ui-toolbar" style="justify-content: space-between">
                        <h4 class="middt-ui-section-title">🔀 Çıkan Geçiş Okları (@transitions.Count)</h4>
                        <RadzenButton Icon="add" Text="Geçiş Ekle" Size="ButtonSize.ExtraSmall" Click="@(() => AddTransition(stateObj))" />
                    </div>
                    <small class="middt-ui-text-muted">İpucu: Tuvalde durumun sağındaki mavi noktadan (●) başka bir duruma basılı tutup sürükleyerek canlı ok çizebilirsiniz.</small>
                    @for (var tri = 0; tri < transitions.Count; tri++)
                    {
                        var trIdx = tri;
                        if (transitions[trIdx] is JsonObject trItem)
                        {
                            <div class="middt-ui-picker">
                                <button type="button" class="middt-wf-edge-pill" style="flex: 1"
                                        @onclick="@(() => SelectTransition(stateKey, trIdx))">
                                    <span>@TriggerIcon(GetString(trItem, "trigger")) @(GetString(trItem, "title") ?? GetString(trItem, "key")) → @(GetString(trItem, "target"))</span>
                                    <small>Düzenle →</small>
                                </button>
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => RemoveSingleEdge(stateKey, trIdx))" />
                            </div>
                        }
                    }
                }
                else
                {
                    <hr class="middt-ui-divider" />
                    <small class="middt-ui-text-muted">🏁 <strong>Finish (Bitiş)</strong> durumlarında akış sonlandığı için çıkış görevi (<code>onExit</code>) veya çıkan geçiş oku (<code>transitions</code>) eklenemez; yalnızca giriş görevleri (<code>onEntry</code>) çalışır.</small>
                }
            </div>
            return;
        }

        @* 4. Default: Workflow Root & Start Node Inspector *@
        var stObj = EnsureObject(doc, "start");
        <div class="middt-ui-form">
            <span class="middt-ui-badge middt-ui-badge-info">🚀 İş Akışı & Başlangıç</span>
            <h3 class="middt-ui-section-title">@(GetString(doc, "title") ?? "İş Akışı Ayarları")</h3>

            <div class="middt-wf-grid-2">
                <div class="middt-ui-input">
                    <label>Akış Anahtarı (key)</label>
                    <input class="middt-wf-input" value="@GetString(doc, "key")"
                           disabled="@(selectedWorkflowKey is not null)"
                           @onchange="@(e => { SetString(doc, "key", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                </div>
                <div class="middt-ui-input">
                    <label>Akış Başlığı (title)</label>
                    <input class="middt-wf-input" value="@GetString(doc, "title")"
                           @onchange="@(e => { SetString(doc, "title", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                </div>
                <div class="middt-ui-input">
                    <label>Menü İkonu (icon)</label>
                    <input class="middt-wf-input" value="@GetString(doc, "icon")" placeholder="account_tree"
                           @onchange="@(e => { SetString(doc, "icon", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                </div>
                <div class="middt-ui-input">
                    <label>Tarihçe Modu (history)</label>
                    <select class="middt-wf-input" value="@(GetString(doc, "history") ?? "Full")"
                            @onchange="@(e => { SetString(doc, "history", e.Value?.ToString()); SyncJsonFromDoc(); })">
                        <option value="Full">Full (Tam Snapshot)</option>
                        <option value="Delta">Delta (JSON Patch Farkı)</option>
                        <option value="None">None (Tarihçe Tutma)</option>
                    </select>
                </div>
                <div class="middt-ui-input">
                    <label>Erişim Modu (instanceAccess.mode)</label>
                    <select class="middt-wf-input" value="@GetAccessMode()"
                            @onchange="@(e => SetAccessMode(e.Value?.ToString()))">
                        <option value="all">all (Yetkili Herkes Görür)</option>
                        <option value="owner">owner (Sadece Başlatan ve Supervisor)</option>
                    </select>
                </div>
                <div class="middt-ui-input">
                    <label>Roller (roles, virgülle)</label>
                    <input class="middt-wf-input" value="@GetCsvArray(doc, "roles")"
                           @onchange="@(e => { SetCsvArray(doc, "roles", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                </div>
            </div>

            <hr class="middt-ui-divider" />
            <h4 class="middt-ui-section-title">🚀 Başlangıç (start) Ayarları</h4>
            <div class="middt-ui-input">
                <label>İlk Hedef Durum (start.target)</label>
                <select class="middt-wf-input" value="@GetString(stObj, "target")"
                        @onchange="@(e => { SetString(stObj, "target", e.Value?.ToString()); SyncJsonFromDoc(); })">
                    @foreach (var st in GetStates())
                    {
                        var k = GetString(st, "key") ?? string.Empty;
                        <option value="@k">@k (@(GetString(st, "title") ?? k))</option>
                    }
                </select>
            </div>
            <div class="middt-ui-input">
                <label>Başlangıç Giriş Kuralı (start.input.rule)</label>
                <input class="middt-wf-input" value="@GetNestedString(stObj, "input", "rule")"
                       placeholder="input.amount > 0"
                       @onchange="@(e => { SetNestedString(stObj, "input", "rule", e.Value?.ToString()); SyncJsonFromDoc(); })" />
            </div>
        </div>
    };

    // --- HTML5 Palette Drag & Drop Handlers ---

    private void StartPaletteStateDrag(DragEventArgs e, string type, string subType, string defaultTitle)
    {
        dragKind = "palette-state";
        dragStateType = type;
        dragStateSubType = subType;
        dragStateTitle = defaultTitle;
    }

    private void StartPaletteTaskDrag(DragEventArgs e, string taskType)
    {
        dragKind = "palette-task";
        dragTaskType = taskType;
    }

    private void StartExistingTaskDrag(DragEventArgs e, string nodeKey, string hook, int taskIndex)
    {
        dragKind = "move-task";
        dragSourceNodeKey = nodeKey;
        dragSourceHook = hook;
        dragSourceIndex = taskIndex;
    }

    private void OnBoardDragOver(DragEventArgs e)
    {
        // Allows drop on board
    }

    private void OnBoardDrop(DragEventArgs e)
    {
        hoverDropKey = null;
        if (dragKind == "palette-state" && dragStateType is not null)
        {
            var dropPos = ComputeBoardDropPos(e);
            CreateStateOnBoard(dragStateType, dragStateSubType ?? "None", dragStateTitle ?? "Yeni Durum", dropPos.X, dropPos.Y);
        }
        else if (dragKind == "palette-task" && dragTaskType is not null)
        {
            var dropPos = ComputeBoardDropPos(e);
            var newStateKey = CreateStateOnBoard("Intermediate", "None", $"{dragTaskType} Adımı", dropPos.X, dropPos.Y);
            if (FindState(newStateKey) is { } stObj)
            {
                var onEntry = EnsureArray(stObj, "onEntry");
                onEntry.Add(CreateTaskNode(dragTaskType));
                SelectStateTask(newStateKey, "onEntry", onEntry.Count - 1);
                SyncJsonFromDoc();
            }
        }

        ClearDragState();
    }

    private void OnDropOntoStateNode(DragEventArgs e, string targetStateKey)
    {
        hoverDropKey = null;
        if (dragKind is "palette-task" or "move-task")
        {
            OnDropOntoHook(e, targetStateKey, "onEntry");
            return;
        }

        OnBoardDrop(e);
    }

    private void ChangeStateType(JsonObject stateObj, string? newType)
    {
        SetString(stateObj, "type", newType);
        if (string.Equals(newType, "Finish", StringComparison.Ordinal))
        {
            stateObj.Remove("onExit");
            stateObj.Remove("transitions");
            stateObj.Remove("subFlow");
        }
        else if (string.Equals(newType, "SubFlow", StringComparison.Ordinal))
        {
            stateObj.Remove("view");
            var sf = EnsureObject(stateObj, "subFlow");
            if (sf["workflow"] is null)
            {
                var firstOther = workflows.FirstOrDefault(w => !string.Equals(w.Key, GetString(doc, "key"), StringComparison.Ordinal))?.Key ?? string.Empty;
                sf["workflow"] = firstOther;
            }
        }
        else
        {
            stateObj.Remove("subFlow");
        }

        SyncJsonFromDoc();
    }

    private void AddSubFlowInputRow(JsonObject sfInputObj)
    {
        var idx = sfInputObj.Count + 1;
        var paramKey = $"param{idx}";
        while (sfInputObj.ContainsKey(paramKey))
        {
            idx++;
            paramKey = $"param{idx}";
        }

        sfInputObj[paramKey] = "data.title";
        SyncJsonFromDoc();
    }

    private void RenameSubFlowInputKey(JsonObject sfInputObj, string oldKey, string? newKey)
    {
        var trimmed = newKey?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(trimmed) || string.Equals(oldKey, trimmed, StringComparison.Ordinal))
        {
            return;
        }

        var existingVal = sfInputObj[oldKey]?.DeepClone();
        sfInputObj.Remove(oldKey);
        sfInputObj[trimmed] = existingVal ?? string.Empty;
        SyncJsonFromDoc();
    }

    private void OnDropOntoHook(DragEventArgs e, string targetNodeKey, string targetHook)
    {
        hoverDropKey = null;
        if (targetHook == "onExit" && FindState(targetNodeKey) is { } tgtSt && GetString(tgtSt, "type") == "Finish")
        {
            ClearDragState();
            return;
        }

        var targetArr = GetHookArray(targetNodeKey, targetHook);
        if (targetArr is null)
        {
            ClearDragState();
            return;
        }

        if (dragKind == "palette-task" && dragTaskType is not null)
        {
            targetArr.Add(CreateTaskNode(dragTaskType));
            selectedNodeKey = targetNodeKey;
            selectedTransitionIndex = -1;
            selectedTaskHook = targetHook;
            selectedTaskIndex = targetArr.Count - 1;
            SyncJsonFromDoc();
        }
        else if (dragKind == "move-task" && dragSourceNodeKey is not null && dragSourceHook is not null)
        {
            var srcArr = GetHookArray(dragSourceNodeKey, dragSourceHook);
            if (srcArr is not null && dragSourceIndex >= 0 && dragSourceIndex < srcArr.Count)
            {
                var moving = srcArr[dragSourceIndex]?.DeepClone();
                if (moving is not null)
                {
                    srcArr.RemoveAt(dragSourceIndex);
                    targetArr.Add(moving);
                    selectedNodeKey = targetNodeKey;
                    selectedTransitionIndex = -1;
                    selectedTaskHook = targetHook;
                    selectedTaskIndex = targetArr.Count - 1;
                    SyncJsonFromDoc();
                }
            }
        }

        ClearDragState();
    }

    private void OnDropOntoTransitionBadge(DragEventArgs e, string stateKey, int transitionIndex)
    {
        hoverDropKey = null;
        if (FindState(stateKey) is not { } stObj)
        {
            ClearDragState();
            return;
        }

        var transitions = EnsureArray(stObj, "transitions");
        if (transitionIndex < 0 || transitionIndex >= transitions.Count || transitions[transitionIndex] is not JsonObject trObj)
        {
            ClearDragState();
            return;
        }

        var onExec = EnsureArray(trObj, "onExecute");
        if (dragKind == "palette-task" && dragTaskType is not null)
        {
            onExec.Add(CreateTaskNode(dragTaskType));
            SelectTransitionTask(stateKey, transitionIndex, onExec.Count - 1);
            SyncJsonFromDoc();
        }
        else if (dragKind == "move-task" && dragSourceNodeKey is not null && dragSourceHook is not null)
        {
            var srcArr = GetHookArray(dragSourceNodeKey, dragSourceHook);
            if (srcArr is not null && dragSourceIndex >= 0 && dragSourceIndex < srcArr.Count)
            {
                var moving = srcArr[dragSourceIndex]?.DeepClone();
                if (moving is not null)
                {
                    srcArr.RemoveAt(dragSourceIndex);
                    onExec.Add(moving);
                    SelectTransitionTask(stateKey, transitionIndex, onExec.Count - 1);
                    SyncJsonFromDoc();
                }
            }
        }

        ClearDragState();
    }

    private void CompleteConnection(string fromNodeKey, string targetStateKey)
    {
        if (fromNodeKey == StartNodeKey)
        {
            var startObj = EnsureObject(doc, "start");
            startObj["target"] = targetStateKey;
            SelectStart();
            SyncJsonFromDoc();
            return;
        }

        if (FindState(fromNodeKey) is not { } fromState || GetString(fromState, "type") == "Finish")
        {
            return;
        }

        var transitions = EnsureArray(fromState, "transitions");
        var actualTarget = string.Equals(fromNodeKey, targetStateKey, StringComparison.Ordinal) ? "$self" : targetStateKey;
        var key = $"to-{targetStateKey}-{transitions.Count + 1}";
        transitions.Add(new JsonObject
        {
            ["key"] = key,
            ["title"] = actualTarget == "$self" ? "Güncelle" : $"Geçiş: {targetStateKey}",
            ["target"] = actualTarget,
            ["trigger"] = "Manual",
        });

        var newIdx = transitions.Count - 1;
        selectedNodeKeys.Clear();
        selectedEdgeIds.Clear();
        selectedEdgeIds.Add(MakeEdgeId(fromNodeKey, newIdx));
        SelectTransition(fromNodeKey, newIdx);
        SyncJsonFromDoc();
    }

