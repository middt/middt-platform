@namespace Middt.Framework.Blazor.Workflow
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.Extensions.DependencyInjection
@using Middt.Framework.Blazor.Ui
@using Middt.Framework.Client.Http
@using Middt.Framework.Model.Workflow
@using Middt.Framework.Ui.Model

<div class="middt-wf-studio" data-testid="workflow-designer">
    @* Top Studio Toolbar *@
    <RadzenCard>
        <div class="middt-ui-toolbar" style="justify-content: space-between">
            <div class="middt-ui-toolbar">
                <label for="wf-select" style="font-weight: 600; font-size: .88rem">İş Akışı:</label>
                <select id="wf-select" class="middt-wf-input" style="width: 240px"
                        value="@(selectedWorkflowKey ?? "")"
                        @onchange="@(e => OnSelectWorkflowAsync(e.Value?.ToString()))">
                    @if (selectedWorkflowKey is null)
                    {
                        <option value="">-- Yeni İş Akışı --</option>
                    }
                    @foreach (var wf in workflows)
                    {
                        <option value="@wf.Key">@(wf.Title ?? wf.Key) (@wf.Key · v@(wf.Version))</option>
                    }
                </select>
                <RadzenButton Icon="add" Text="Yeni Akış" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="NewWorkflow" />
                <span class="middt-ui-badge middt-ui-badge-info">v@(GetInt(doc, "version", 1))</span>
            </div>

            <div class="middt-wf-tabs" style="margin: 0; border: 0; padding: 0" role="tablist">
                <button type="button" class="@(activeTab == "visual" ? "middt-wf-tab middt-wf-tab-active" : "middt-wf-tab")"
                        @onclick="@(() => SwitchTab("visual"))">
                    🎨 Sürükle-Bırak Tuval
                </button>
                <button type="button" class="@(activeTab == "schema" ? "middt-wf-tab middt-wf-tab-active" : "middt-wf-tab")"
                        @onclick="@(() => SwitchTab("schema"))">
                    🗂️ Veri Şeması (dataSchema)
                </button>
                <button type="button" class="@(activeTab == "json" ? "middt-wf-tab middt-wf-tab-active" : "middt-wf-tab")"
                        @onclick="@(() => SwitchTab("json"))">
                    { } JSON Kodu
                </button>
                <button type="button" class="middt-wf-tab"
                        title="Bu iş akışının ekranlarını doğrudan tasarla veya yeni ekran oluştur"
                        @onclick="OpenToolbarScreenDesigner">
                    🖥️ Ekran Tasarımcısı
                </button>
            </div>

            <div class="middt-ui-toolbar">
                @if (activeTab == "visual")
                {
                    <RadzenButton Icon="select_all" Text="Tümünü Seç" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="SelectAllOnBoard" />
                    <RadzenButton Icon="auto_fix_high" Text="Otomatik Hizala" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="AutoLayoutBoard" />
                    <RadzenButton Icon="zoom_out" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => ChangeZoom(-0.1))" />
                    <span style="font-size: .8rem; font-weight: 600; min-width: 42px; text-align: center">@(Math.Round(zoom * 100))%</span>
                    <RadzenButton Icon="zoom_in" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => ChangeZoom(0.1))" />
                }
                <RadzenButton Icon="rule" Text="Doğrula" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="ValidateAsync" />
                <RadzenButton Icon="save" Text="Kaydet" Size="ButtonSize.Small" Click="SaveAsync" IsBusy="busy" />
            </div>
        </div>

        @if (errors.Count > 0)
        {
            <div class="middt-ui-alert middt-ui-alert-danger rz-mt-2" role="alert">
                <strong>@errors.Count doğrulama hatası:</strong>
                <ul class="middt-ui-list">
                    @foreach (var err in errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
        else if (validMessage is not null)
        {
            <div class="middt-ui-alert middt-ui-alert-success rz-mt-2" role="status">@validMessage</div>
        }
    </RadzenCard>

    @if (activeTab == "visual")
    {
        <div class="@GetStudioBodyClass()">
            @* 1. Left Drag & Drop Palette *@
            @if (showPalette)
            {
                <aside class="middt-wf-palette" aria-label="Sürükle bırak bileşen paleti">
                    <div class="middt-wf-palette-group">
                        <div class="middt-wf-palette-group-title">📍 Durumlar (Tuvale Sürükle)</div>
                        @foreach (var stTpl in StateTemplates)
                        {
                            <div class="middt-wf-palette-chip"
                                 draggable="true"
                                 title="Tuvale sürükleyip bırakın veya çift tıklayın"
                                 @ondragstart="@(e => StartPaletteStateDrag(e, stTpl.Type, stTpl.SubType, stTpl.DefaultTitle))"
                                 @ondblclick="@(() => AddStateAtDefaultPos(stTpl.Type, stTpl.SubType, stTpl.DefaultTitle))">
                                <span class="middt-wf-palette-chip-icon">@stTpl.Icon</span>
                                <div class="middt-wf-palette-chip-text">
                                    <strong>@stTpl.Label</strong>
                                    <small>@stTpl.Type / @stTpl.SubType</small>
                                </div>
                            </div>
                        }
                    </div>

                    <hr class="middt-ui-divider" />

                    <div class="middt-wf-palette-group">
                        <div class="middt-wf-palette-group-title">⚡ Görevler (Durum / Oka Sürükle)</div>
                        <input class="middt-wf-input" placeholder="Görev ara (set, http, agent...)" @bind="paletteFilter" @bind:event="oninput" />
                        @foreach (var grp in FilteredTaskGroups())
                        {
                            <div class="middt-wf-palette-group-title">@grp.Key</div>
                            @foreach (var spec in grp)
                            {
                                <div class="middt-wf-palette-chip"
                                     draggable="true"
                                     title="@spec.Description — Bir durumun veya geçiş okunun üzerine sürükleyin"
                                     @ondragstart="@(e => StartPaletteTaskDrag(e, spec.Name))"
                                     @ondblclick="@(() => QuickAddTaskToSelection(spec.Name))">
                                    <span class="middt-wf-palette-chip-icon">⚡</span>
                                    <div class="middt-wf-palette-chip-text">
                                        <strong>@spec.Title</strong>
                                        <small>@spec.Name</small>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </aside>
            }

            @* 2. Center 2D Interactive SVG + Nodes Board *@
            <div class="@GetViewportClass()"
                 tabindex="0"
                 aria-label="2B İş Akışı Çizim Tuvali"
                 style="background-position: @(F(panX))px @(F(panY))px"
                 @onpointerdown="OnViewportPointerDown"
                 @onpointermove="OnBoardPointerMove"
                 @onpointerup="OnBoardPointerUp"
                 @onkeydown="OnCanvasKeyDown">

                @* Floating Tool Mode Dock (Pointer/Select vs Hand/Pan + Panel Toggles) *@
                <div class="middt-wf-tool-dock" @onpointerdown:stopPropagation="true">
                    <button type="button"
                            class="middt-wf-tool-btn"
                            title="@(showPalette ? "Sol bileşen paletini gizle (Tuvali genişlet)" : "Sol bileşen paletini göster")"
                            @onclick="@(() => showPalette = !showPalette)">
                        @(showPalette ? "◀ Palet" : "▶ Palet")
                    </button>
                    <button type="button"
                            class="@(toolMode == "select" ? "middt-wf-tool-btn middt-wf-tool-btn-active" : "middt-wf-tool-btn")"
                            title="İmleç / Seçim Modu: Nesnelere odaklanın, boş alanda basılı tutup kutu çizerek çoklu seçin veya nesneleri taşıyın"
                            @onclick="@(() => toolMode = "select")">
                        🖱️ Seç / Odakla
                    </button>
                    <button type="button"
                            class="@(toolMode == "pan" ? "middt-wf-tool-btn middt-wf-tool-btn-active" : "middt-wf-tool-btn")"
                            title="El Aracı (Kaydırma Modu): Sol tuşa basılı tutarak çizim alanını sola, sağa, yukarı ve aşağı kaydırın"
                            @onclick="@(() => toolMode = "pan")">
                        ✋ El Aracı (Kaydır)
                    </button>
                    <button type="button"
                            class="middt-wf-tool-btn"
                            title="Görünümü ve yakınlaştırmayı merkeze sıfırla"
                            @onclick="ResetViewport">
                        🎯 Merkeze Al
                    </button>
                    <button type="button"
                            class="middt-wf-tool-btn"
                            title="@(showInspector ? "Sağ özellikler panelini gizle (Tuvali genişlet)" : "Sağ özellikler panelini göster")"
                            @onclick="@(() => showInspector = !showInspector)">
                        @(showInspector ? "Özellikler ▶" : "◀ Özellikler")
                    </button>
                </div>

                @* Floating Multi-Selection & Group Action Bar *@
                @if (selectedNodeKeys.Count > 0 || selectedEdgeIds.Count > 0)
                {
                    <div class="middt-wf-selection-bar" @onpointerdown:stopPropagation="true">
                        <span>
                            📦
                            @if (selectedNodeKeys.Count > 0)
                            {
                                <strong>@selectedNodeKeys.Count Durum</strong>
                            }
                            @if (selectedNodeKeys.Count > 0 && selectedEdgeIds.Count > 0)
                            {
                                <span> · </span>
                            }
                            @if (selectedEdgeIds.Count > 0)
                            {
                                <strong>@selectedEdgeIds.Count Ok</strong>
                            }
                            seçili
                        </span>

                        @if (selectedNodeKeys.Count > 1)
                        {
                            <button type="button" class="middt-wf-selection-btn" title="Seçili durumları yatay hizala" @onclick="AlignSelectedHorizontal">
                                📐 Yatay Hizala
                            </button>
                            <button type="button" class="middt-wf-selection-btn" title="Seçili durumları dikey hizala" @onclick="AlignSelectedVertical">
                                📐 Dikey Hizala
                            </button>
                        }
                        @if (selectedNodeKeys.Count(k => k != StartNodeKey) > 0)
                        {
                            <button type="button" class="middt-wf-selection-btn" title="Seçili durumları çoğalt" @onclick="DuplicateSelectedStates">
                                📑 Çoğalt
                            </button>
                        }
                        <button type="button" class="middt-wf-selection-btn middt-wf-selection-btn-danger" title="Seçili tüm durumları ve okları sil (Delete)" @onclick="DeleteSelection">
                            🗑️ Seçilenleri Sil (@(selectedNodeKeys.Count(k => k != StartNodeKey) + selectedEdgeIds.Count))
                        </button>
                        <button type="button" class="middt-wf-selection-btn" title="Seçimi temizle (Esc)" @onclick="ClearSelection">
                            ✕ Temizle
                        </button>
                    </div>
                }

                <div class="middt-wf-board"
                     style="transform: translate(@(F(panX))px, @(F(panY))px) scale(@zoom.ToString("0.##", CultureInfo.InvariantCulture))"
                     @onpointerdown:stopPropagation="true"
                     @onpointerdown="OnBoardPointerDown"
                     @ondragover="OnBoardDragOver"
                     @ondragover:preventDefault="true"
                     @ondrop="OnBoardDrop">

                    @* Rubber-Band / Marquee Box Selection Overlay *@
                    @if (pointerMode == "lasso")
                    {
                        var lx = Math.Min(lassoStartX, lassoCurrentX);
                        var ly = Math.Min(lassoStartY, lassoCurrentY);
                        var lw = Math.Abs(lassoCurrentX - lassoStartX);
                        var lh = Math.Abs(lassoCurrentY - lassoStartY);
                        <div class="middt-wf-lasso"
                             style="left: @(F(lx))px; top: @(F(ly))px; width: @(F(lw))px; height: @(F(lh))px"></div>
                    }

                    @* SVG Bezier Connections Layer *@
                    <svg class="middt-wf-svg-layer" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <marker id="wf-arrow-default" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
                                <path d="M0,0 L10,4 L0,8 Z" fill="#64748b" />
                            </marker>
                            <marker id="wf-arrow-selected" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
                                <path d="M0,0 L10,4 L0,8 Z" fill="#2563eb" />
                            </marker>
                            <marker id="wf-arrow-start" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto">
                                <path d="M0,0 L10,4 L0,8 Z" fill="#0284c7" />
                            </marker>
                        </defs>

                        @* Start -> start.target edge *@
                        @{
                            var startObj = EnsureObject(doc, "start");
                            var startTargetKey = GetString(startObj, "target");
                            if (!string.IsNullOrWhiteSpace(startTargetKey) && FindState(startTargetKey) is not null)
                            {
                                var startEdge = ComputeEdgeGeometry(StartNodeKey, startTargetKey, 0, 1);
                                <g class="middt-wf-edge-group"
                                   @onpointerdown:stopPropagation="true"
                                   @onclick:stopPropagation="true"
                                   @onclick="SelectStart">
                                    <path d="@startEdge.Path" class="middt-wf-edge-hit" />
                                    <path d="@startEdge.Path" class="middt-wf-edge-path-start" marker-end="url(#wf-arrow-start)" />
                                </g>
                            }

                            @* State Transitions (Clickable & Selectable Curves) *@
                            foreach (var edge in BuildAllEdges())
                            {
                                var eCopy = edge;
                                var isSel = IsEdgeSelected(eCopy.EdgeId);
                                <g class="middt-wf-edge-group"
                                   @onpointerdown:stopPropagation="true"
                                   @onclick:stopPropagation="true"
                                   @onclick="@(ev => OnEdgeClick(ev, eCopy.FromKey, eCopy.TransitionIndex))">
                                    <path d="@eCopy.Geometry.Path" class="middt-wf-edge-hit" />
                                    <path d="@eCopy.Geometry.Path"
                                          class="@(isSel ? "middt-wf-edge-path-selected" : "middt-wf-edge-path")"
                                          marker-end="@(isSel ? "url(#wf-arrow-selected)" : "url(#wf-arrow-default)")" />
                                </g>
                            }

                            @* Live Preview Wire while drawing a connection arrow with the mouse *@
                            if (pointerMode == "connect-wire" && pointerSourceNodeKey is not null)
                            {
                                var previewPath = ComputePreviewWirePath(pointerSourceNodeKey, wireCursorX, wireCursorY);
                                <path d="@previewPath" class="middt-wf-edge-path-preview" marker-end="url(#wf-arrow-selected)" />
                            }
                        }
                    </svg>

                    @* Interactive Transition Badges on Midpoints of SVG Edges *@
                    @foreach (var edge in BuildAllEdges())
                    {
                        var eCopy = edge;
                        var isSel = IsEdgeSelected(eCopy.EdgeId);
                        <div class="@(isSel ? "middt-wf-edge-badge middt-wf-edge-badge-active" : "middt-wf-edge-badge")"
                             style="left: @(F(eCopy.Geometry.MidX))px; top: @(F(eCopy.Geometry.MidY))px"
                             title="Oku seçmek için tıklayın (Shift+Tık: çoklu seçim) veya üzerine görev sürükleyin"
                             @onpointerdown:stopPropagation="true"
                             @onclick:stopPropagation="true"
                             @onclick="@(ev => OnEdgeClick(ev, eCopy.FromKey, eCopy.TransitionIndex))"
                             @ondragover:preventDefault="true"
                             @ondragover:stopPropagation="true"
                             @ondrop:stopPropagation="true"
                             @ondrop="@(e => OnDropOntoTransitionBadge(e, eCopy.FromKey, eCopy.TransitionIndex))">
                            <span>@TriggerIcon(eCopy.Trigger) @eCopy.Label</span>
                            @if (eCopy.TaskCount > 0)
                            {
                                <span class="middt-ui-badge middt-ui-badge-primary" style="font-size: .65rem; padding: .05rem .35rem">⚡@eCopy.TaskCount</span>
                            }
                            <button type="button"
                                    class="middt-wf-edge-del"
                                    title="Bu geçiş okunu sil"
                                    @onclick:stopPropagation="true"
                                    @onclick="@(() => RemoveSingleEdge(eCopy.FromKey, eCopy.TransitionIndex))">✕</button>
                        </div>
                    }

                    @* Start Node on 2D Board *@
                    @{
                        var startPos = GetNodePos(StartNodeKey);
                        var startNodeObj = EnsureObject(doc, "start");
                        var startTasks = EnsureArray(startNodeObj, "onExecute");
                    }
                    <div class="@GetStartNodeClass()"
                         style="left: @(F(startPos.X))px; top: @(F(startPos.Y))px"
                         @onpointerdown:stopPropagation="true"
                         @onpointerdown="@(ev => OnNodeHeaderPointerDown(ev, StartNodeKey))">
                        <div class="middt-wf-board-node-handle"
                             title="Taşımak için basılı tutup sürükleyin">
                            <div>
                                <div class="middt-wf-node-title">🚀 Başlangıç (start)</div>
                                <div class="middt-wf-node-key">Hedef: @(GetString(startNodeObj, "target") ?? "-")</div>
                            </div>
                            <span class="middt-ui-badge middt-ui-badge-info">Start</span>
                        </div>

                        <div class="middt-wf-node-section">
                            <span class="middt-wf-node-section-label">onExecute Görevleri (@startTasks.Count)</span>
                            <div class="@(hoverDropKey == "start:onExecute" ? "middt-wf-dropzone middt-wf-dropzone-over" : "middt-wf-dropzone")"
                                 @ondragenter="@(() => hoverDropKey = "start:onExecute")"
                                 @ondragleave="@(() => ClearHoverDrop("start:onExecute"))"
                                 @ondragover:preventDefault="true"
                                 @ondragover:stopPropagation="true"
                                 @ondrop:stopPropagation="true"
                                 @ondrop="@(e => OnDropOntoHook(e, StartNodeKey, "onExecute"))">
                                @if (startTasks.Count == 0)
                                {
                                    <div class="middt-wf-dropzone-empty">+ Görevi buraya sürükleyin</div>
                                }
                                @for (var ti = 0; ti < startTasks.Count; ti++)
                                {
                                    var taskIdx = ti;
                                    if (startTasks[taskIdx] is JsonObject tObj)
                                    {
                                        <button type="button"
                                                draggable="true"
                                                class="@(selectedNodeKey == StartNodeKey && selectedTaskHook == "onExecute" && selectedTaskIndex == taskIdx ? "middt-wf-task-pill middt-wf-task-pill-active" : "middt-wf-task-pill")"
                                                @onpointerdown:stopPropagation="true"
                                                @onclick:stopPropagation="true"
                                                @onclick="@(() => SelectStartTask(taskIdx))"
                                                @ondragstart:stopPropagation="true"
                                                @ondragstart="@(e => StartExistingTaskDrag(e, StartNodeKey, "onExecute", taskIdx))">
                                            <span>⚡ @TaskSummary(tObj)</span>
                                            <small>@TaskBadges(tObj)</small>
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        @* Output Port for Start Node (Drag with mouse to draw arrow!) *@
                        <button type="button"
                                class="@(pointerMode == "connect-wire" && pointerSourceNodeKey == StartNodeKey ? "middt-wf-port middt-wf-port-out middt-wf-port-active" : "middt-wf-port middt-wf-port-out")"
                                title="Başlangıç okunu çizmek için basılı tutup hedef duruma sürükleyin"
                                @onpointerdown:stopPropagation="true"
                                @onpointerdown="@(ev => OnOutputPortPointerDown(ev, StartNodeKey))"
                                @onclick:stopPropagation="true"></button>
                    </div>

                    @* State Nodes on 2D Board *@
                    @foreach (var stateObj in GetStates())
                    {
                        var stateKey = GetString(stateObj, "key") ?? string.Empty;
                        var stateTitle = GetString(stateObj, "title") ?? stateKey;
                        var stateType = GetString(stateObj, "type") ?? "Intermediate";
                        var stateSubType = GetString(stateObj, "subType") ?? "None";
                        var pos = GetNodePos(stateKey);
                        var onEntry = EnsureArray(stateObj, "onEntry");
                        var onExit = EnsureArray(stateObj, "onExit");

                        <div class="@GetBoardNodeClass(stateKey, stateType, stateSubType)"
                             style="left: @(F(pos.X))px; top: @(F(pos.Y))px"
                             @onpointerenter="@(() => OnNodePointerEnter(stateKey))"
                             @onpointerleave="@(() => OnNodePointerLeave(stateKey))"
                             @onpointerup="@(ev => OnNodePointerUp(ev, stateKey))"
                             @onpointerdown:stopPropagation="true"
                             @onpointerdown="@(ev => OnNodeHeaderPointerDown(ev, stateKey))"
                             @ondragover:preventDefault="true"
                             @ondrop:stopPropagation="true"
                             @ondrop="@(e => OnDropOntoStateNode(e, stateKey))">

                            @* Input Port (Left) *@
                            <button type="button"
                                    class="@(hoverConnectTargetKey == stateKey ? "middt-wf-port middt-wf-port-in middt-wf-port-active" : "middt-wf-port middt-wf-port-in")"
                                    title="Geçiş okunu buraya bırakın"
                                    @onpointerup:stopPropagation="true"
                                    @onpointerup="@(ev => OnNodePointerUp(ev, stateKey))"
                                    @onpointerdown:stopPropagation="true"></button>

                            @* Mouse-Draggable Header (Supports Single & Group Move!) *@
                            <div class="middt-wf-board-node-handle"
                                 title="Taşımak için basılı tutup sürükleyin (Çoklu seçimde tüm grubu taşır)">
                                <div>
                                    <div class="middt-wf-node-title">@stateTitle</div>
                                    <div class="middt-wf-node-key">@stateKey @(GetIntNullable(stateObj, "step") is { } st ? $"· Adım {st}" : null)</div>
                                </div>
                                <span class="middt-ui-badge @StateBadgeClass(stateType, stateSubType)">@stateType@(stateSubType != "None" ? $"/{stateSubType}" : "")</span>
                            </div>

                            @if (stateType == "SubFlow")
                            {
                                var sfWorkflow = GetNestedString(stateObj, "subFlow", "workflow");
                                var sfOut = GetNestedString(stateObj, "subFlow", "outputInto");
                                <small class="middt-ui-text-muted">
                                    🔗 Alt Akış: <code>@(string.IsNullOrWhiteSpace(sfWorkflow) ? "(Seçilmedi)" : sfWorkflow)</code>@(!string.IsNullOrWhiteSpace(sfOut) ? $" → {sfOut}" : null)
                                </small>
                            }
                            else if (stateObj["view"] is JsonObject viewObj && GetString(viewObj, "layout") is { Length: > 0 } layoutKey)
                            {
                                <button type="button"
                                        class="middt-wf-edge-pill"
                                        style="font-size: .73rem; padding: .15rem .45rem"
                                        title="Bu durumun ekranını ('@layoutKey') görsel tasarımcıda düzenlemek için tıklayın"
                                        @onpointerdown:stopPropagation="true"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => OpenScreenDesignerForState(stateObj, layoutKey))">
                                    <span>📄 Ekran: <code>@layoutKey</code></span>
                                    <small>🎨 Düzenle</small>
                                </button>
                            }

                            @* onEntry Dropzone *@
                            <div class="middt-wf-node-section">
                                <span class="middt-wf-node-section-label">onEntry Görevleri (@onEntry.Count)</span>
                                <div class="@(hoverDropKey == $"{stateKey}:onEntry" ? "middt-wf-dropzone middt-wf-dropzone-over" : "middt-wf-dropzone")"
                                     @ondragenter="@(() => hoverDropKey = $"{stateKey}:onEntry")"
                                     @ondragleave="@(() => ClearHoverDrop($"{stateKey}:onEntry"))"
                                     @ondragover:preventDefault="true"
                                     @ondragover:stopPropagation="true"
                                     @ondrop:stopPropagation="true"
                                     @ondrop="@(e => OnDropOntoHook(e, stateKey, "onEntry"))">
                                    @if (onEntry.Count == 0)
                                    {
                                        <div class="middt-wf-dropzone-empty">+ Görevi buraya sürükleyin</div>
                                    }
                                    @for (var ti = 0; ti < onEntry.Count; ti++)
                                    {
                                        var taskIdx = ti;
                                        if (onEntry[taskIdx] is JsonObject tObj)
                                        {
                                            <button type="button"
                                                    draggable="true"
                                                    class="@(selectedNodeKey == stateKey && selectedTaskHook == "onEntry" && selectedTaskIndex == taskIdx ? "middt-wf-task-pill middt-wf-task-pill-active" : "middt-wf-task-pill")"
                                                    @onpointerdown:stopPropagation="true"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="@(() => SelectStateTask(stateKey, "onEntry", taskIdx))"
                                                    @ondragstart:stopPropagation="true"
                                                    @ondragstart="@(e => StartExistingTaskDrag(e, stateKey, "onEntry", taskIdx))">
                                                <span>⚡ @TaskSummary(tObj)</span>
                                                <small>@TaskBadges(tObj)</small>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>

                            @* onExit Dropzone (Not available on Finish states because the workflow ends here) *@
                            @if (stateType != "Finish")
                            {
                                <div class="middt-wf-node-section">
                                    <span class="middt-wf-node-section-label">onExit Görevleri (@onExit.Count)</span>
                                    <div class="@(hoverDropKey == $"{stateKey}:onExit" ? "middt-wf-dropzone middt-wf-dropzone-over" : "middt-wf-dropzone")"
                                         @ondragenter="@(() => hoverDropKey = $"{stateKey}:onExit")"
                                         @ondragleave="@(() => ClearHoverDrop($"{stateKey}:onExit"))"
                                         @ondragover:preventDefault="true"
                                         @ondragover:stopPropagation="true"
                                         @ondrop:stopPropagation="true"
                                         @ondrop="@(e => OnDropOntoHook(e, stateKey, "onExit"))">
                                        @if (onExit.Count == 0)
                                        {
                                            <div class="middt-wf-dropzone-empty">+ Çıkış görevi sürükleyin</div>
                                        }
                                        @for (var ti = 0; ti < onExit.Count; ti++)
                                        {
                                            var taskIdx = ti;
                                            if (onExit[taskIdx] is JsonObject tObj)
                                            {
                                                <button type="button"
                                                        draggable="true"
                                                        class="@(selectedNodeKey == stateKey && selectedTaskHook == "onExit" && selectedTaskIndex == taskIdx ? "middt-wf-task-pill middt-wf-task-pill-active" : "middt-wf-task-pill")"
                                                        @onpointerdown:stopPropagation="true"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="@(() => SelectStateTask(stateKey, "onExit", taskIdx))"
                                                        @ondragstart:stopPropagation="true"
                                                        @ondragstart="@(e => StartExistingTaskDrag(e, stateKey, "onExit", taskIdx))">
                                                    <span>🚪 @TaskSummary(tObj)</span>
                                                    <small>@TaskBadges(tObj)</small>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @* Output Port (Right) — Press and drag with mouse to draw an arrow! *@
                            @if (stateType != "Finish")
                            {
                                <button type="button"
                                        class="@(pointerMode == "connect-wire" && pointerSourceNodeKey == stateKey ? "middt-wf-port middt-wf-port-out middt-wf-port-active" : "middt-wf-port middt-wf-port-out")"
                                        title="Ok çizmek için basılı tutup hedef duruma sürükleyin"
                                        @onpointerdown:stopPropagation="true"
                                        @onpointerdown="@(ev => OnOutputPortPointerDown(ev, stateKey))"
                                        @onclick:stopPropagation="true"></button>
                            }
                        </div>
                    }
                </div>

                <div class="middt-wf-canvas-hint">
                    <span>🖱️ <strong>Seç / Odakla:</strong> Boşta sürükleyerek kutu seçimi, nesneye tıklayıp odaklanma</span>
                    <span>·</span>
                    <span>✋ <strong>El Aracı:</strong> Tuvali sola / sağa / yukarı / aşağı kaydır</span>
                    <span>·</span>
                    <span><strong>Sağ noktadan (●) sürükle:</strong> Ok çiz</span>
                </div>
            </div>

            @* 3. Right Context-Sensitive Inspector *@
            @if (showInspector)
            {
                <aside class="middt-wf-inspector" aria-label="Seçili öğe özellikleri">
                    @RenderInspector()
                </aside>
            }
        </div>
    }
    else if (activeTab == "schema")
    {
        <RadzenCard>
            <div class="middt-ui-form">
                <div class="middt-ui-toolbar" style="justify-content: space-between">
                    <div>
                        <h3 class="middt-ui-section-title">🗂️ İş Akışı Veri Şeması (dataSchema)</h3>
                        <small class="middt-ui-text-muted">Burada tanımlanan alanlar liste kolonlarını, arama filtrelerini ve PostgreSQL bölüm (partition) indekslerini otomatik oluşturur.</small>
                    </div>
                    <div class="middt-ui-toolbar">
                        <input class="middt-wf-input" style="width: 180px" placeholder="Yeni alan adı (ör. amount)" @bind="newSchemaFieldName" />
                        <RadzenButton Icon="add" Text="Alan Ekle" Size="ButtonSize.Small" Click="AddSchemaField" />
                    </div>
                </div>

                @{
                    var schemaObj = EnsureObject(doc, "dataSchema");
                    var propsObj = EnsureObject(schemaObj, "properties");
                    var reqArr = EnsureArray(schemaObj, "required");
                }
                @foreach (var prop in propsObj.ToList())
                {
                    var fieldName = prop.Key;
                    if (prop.Value is JsonObject fieldSpec)
                    {
                        var isReq = reqArr.Any(x => x?.GetValue<string>() == fieldName);
                        <div class="middt-wf-task-card">
                            <div class="middt-ui-toolbar" style="justify-content: space-between">
                                <strong><code>@fieldName</code> — @(GetString(fieldSpec, "title") ?? fieldName)</strong>
                                <RadzenButton Icon="delete" Text="Sil" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => RemoveSchemaField(fieldName))" />
                            </div>
                            <div class="middt-wf-grid-3">
                                <div class="middt-ui-input">
                                    <label>Başlık (title)</label>
                                    <input class="middt-wf-input" value="@GetString(fieldSpec, "title")"
                                           @onchange="@(e => { SetString(fieldSpec, "title", e.Value?.ToString()); SyncJsonFromDoc(); })" />
                                </div>
                                <div class="middt-ui-input">
                                    <label>Veri Tipi (type)</label>
                                    <select class="middt-wf-input" value="@(GetString(fieldSpec, "type") ?? "string")"
                                            @onchange="@(e => { SetString(fieldSpec, "type", e.Value?.ToString()); SyncJsonFromDoc(); })">
                                        <option value="string">string (Metin)</option>
                                        <option value="number">number (Ondalıklı Sayı / Tutar)</option>
                                        <option value="integer">integer (Tam Sayı)</option>
                                        <option value="boolean">boolean (Evet / Hayır)</option>
                                        <option value="array">array (Dizi / Liste)</option>
                                        <option value="object">object (Alt Nesne)</option>
                                    </select>
                                </div>
                                <div class="middt-ui-input">
                                    <label>Maskeleme (x-mask)</label>
                                    <select class="middt-wf-input" value="@(GetString(fieldSpec, "x-mask") ?? "")"
                                            @onchange="@(e => { SetString(fieldSpec, "x-mask", e.Value?.ToString()); SyncJsonFromDoc(); })">
                                        <option value="">Maskeleme Yok</option>
                                        <option value="middle">middle (Ortasını Maskele)</option>
                                        <option value="end">end (Sonunu Maskele)</option>
                                    </select>
                                </div>
                                <label class="middt-ui-check">
                                    <input type="checkbox" checked="@isReq"
                                           @onchange="@(e => ToggleRequiredField(reqArr, fieldName, e.Value is true))" />
                                    <span>Zorunlu Alan (required)</span>
                                </label>
                                <label class="middt-ui-check">
                                    <input type="checkbox" checked="@GetBool(fieldSpec, "x-search")"
                                           @onchange="@(e => { SetBool(fieldSpec, "x-search", e.Value is true); SyncJsonFromDoc(); })" />
                                    <span>Arama Filtresi & İndeks (x-search)</span>
                                </label>
                                <label class="middt-ui-check">
                                    <input type="checkbox" checked="@(fieldSpec["x-list"]?.GetValue<bool>() ?? true)"
                                           @onchange="@(e => { fieldSpec["x-list"] = e.Value is true; SyncJsonFromDoc(); })" />
                                    <span>Listede Kolon Göster (x-list)</span>
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
        </RadzenCard>
    }
    else if (activeTab == "json")
    {
        <RadzenCard>
            <div class="middt-ui-form">
                <div class="middt-ui-toolbar" style="justify-content: space-between">
                    <label for="wf-definition-json" class="middt-ui-text-muted">İş Akışı Tanımı JSON (Sürükle-bırak tuval ile çift yönlü senkronize)</label>
                    <RadzenButton Icon="data_object" Text="JSON Biçimlendir" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="FormatJson" />
                </div>
                <textarea id="wf-definition-json" class="middt-ui-editor rz-textarea" spellcheck="false"
                          value="@json" @oninput="OnRawJsonInput"></textarea>
            </div>
        </RadzenCard>
    }

    @if (screenModalOpen)
    {
        <div class="middt-wf-modal-backdrop" @onclick="@(() => screenModalOpen = false)">
            <div class="middt-wf-modal" @onclick:stopPropagation="true">
                <div class="middt-wf-modal-header">
                    <div style="display: flex; align-items: center; gap: .6rem">
                        <span>🖥️</span>
                        <strong>Görsel Ekran & Yerleşim Tasarımcısı</strong>
                        @if (screenModalTargetStateKey is not null)
                        {
                            <span class="middt-ui-badge middt-ui-badge-primary">
                                Bağlı Durum: @screenModalTargetStateKey
                            </span>
                        }
                    </div>
                    <RadzenButton Icon="close" Text="Kapat" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => screenModalOpen = false)" />
                </div>
                <div class="middt-wf-modal-body">
                    <UiLayoutEditor @key="screenModalSession"
                                    Embedded="true"
                                    InitialKey="@screenModalKey"
                                    InitialWorkflowKey="@GetString(doc, "key")"
                                    InitialDocument="@screenModalDoc"
                                    OnSavedKey="OnScreenModalSavedAsync"
                                    OnChanged="LoadUiLayoutsAsync"
                                    OnClose="@(() => screenModalOpen = false)" />
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string StartNodeKey = "__start__";
    private const double StartNodeWidth = 230;
    private const double StateNodeWidth = 264;
    private const double NodeApproxHeight = 165;
    private const double PortOffsetY = 30;

    private static readonly JsonSerializerOptions PrettyJson = new()
    {
        WriteIndented = true,
    };

    private sealed record StatePaletteTemplate(string Icon, string Label, string Type, string SubType, string DefaultTitle);

    private static readonly IReadOnlyList<StatePaletteTemplate> StateTemplates =
    [
        new("👤", "İnsan Görevi Durumu", "Intermediate", "Human", "Uzman İncelemesi"),
        new("⚙️", "Otomatik Sistem Durumu", "Intermediate", "None", "Sistem Kontrolü"),
        new("🔀", "Alt İş Akışı Durumu", "SubFlow", "None", "Alt Akış Bekleme"),
        new("✅", "Başarılı Bitiş Durumu", "Finish", "Success", "Onaylandı"),
        new("❌", "Red / Hata Bitişi", "Finish", "Error", "Reddedildi"),
        new("🚫", "İptal Bitiş Durumu", "Finish", "Cancelled", "İptal Edildi"),
    ];

    private sealed record NodePoint(double X, double Y);
    private sealed record EdgeGeometry(string Path, double MidX, double MidY);
    private sealed record CanvasEdge(string EdgeId, string FromKey, string TargetKey, int TransitionIndex, string Key, string Label, string Trigger, int TaskCount, EdgeGeometry Geometry);

    private List<WorkflowSummaryModel> workflows = [];
    private List<WorkflowTaskSpecModel> taskSpecs = [];
    private List<UiLayoutSummary> uiLayouts = [];
    private List<string> errors = [];
    private Dictionary<string, NodePoint> nodePositions = new(StringComparer.Ordinal);
    private HashSet<string> selectedNodeKeys = new(StringComparer.Ordinal);
    private HashSet<string> selectedEdgeIds = new(StringComparer.Ordinal);
    private string? selectedWorkflowKey;
    private string selectedNodeKey = StartNodeKey;
    private string selectedTaskHook = "onEntry";
    private int selectedTaskIndex = -1;
    private int selectedTransitionIndex = -1;
    private string activeTab = "visual";
    private string paletteFilter = string.Empty;
    private string newSchemaFieldName = string.Empty;
    private string? validMessage;
    private string? hoverDropKey;
    private string? hoverConnectTargetKey;
    private double zoom = 1.0;
    private double panX;
    private double panY;
    private string toolMode = "select"; // "select" | "pan"
    private bool showPalette = true;
    private bool showInspector = true;
    private bool busy;

    // Inline Screen / Layout Designer Modal state
    private bool screenModalOpen;
    private int screenModalSession;
    private string? screenModalTargetStateKey;
    private string? screenModalKey;
    private UiLayoutDocument? screenModalDoc;

    // Mouse / Pointer interaction state ("move-nodes" | "connect-wire" | "lasso" | "pan" | null)
    private string? pointerMode;
    private string? pointerSourceNodeKey;
    private double pointerStartClientX;
    private double pointerStartClientY;
    private double panStartX;
    private double panStartY;
    private bool pointerMoved;
    private Dictionary<string, NodePoint> moveInitialPositions = new(StringComparer.Ordinal);
    private double wireStartX;
    private double wireStartY;
    private double wireCursorX;
    private double wireCursorY;
    private double lassoStartX;
    private double lassoStartY;
    private double lassoCurrentX;
    private double lassoCurrentY;

    // HTML5 Palette Drag state
    private string? dragKind; // "palette-state" | "palette-task" | "move-task"
    private string? dragStateType;
    private string? dragStateSubType;
    private string? dragStateTitle;
    private string? dragTaskType;
    private string? dragSourceNodeKey;
    private string? dragSourceHook;
    private int dragSourceIndex = -1;

    private JsonObject doc = CreateStarterWorkflow();
    private string json = string.Empty;

    [Inject]
    private WorkflowApiClient Client { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        EnsureNodePositions(forceAutoLayout: true);
        SyncJsonFromDoc();

        var wfTask = Client.ListWorkflowsAsync();
        var specsTask = Client.ListTaskSpecsAsync();
        var layoutsTask = LoadUiLayoutsAsync();
        await Task.WhenAll(wfTask, specsTask, layoutsTask);

        var wfResp = await wfTask;
        if (wfResp.IsSuccess)
        {
            workflows = wfResp.Data ?? [];
        }

        var specsResp = await specsTask;
        if (specsResp.IsSuccess)
        {
            taskSpecs = specsResp.Data ?? [];
        }

        if (workflows.Count > 0)
        {
            await OpenWorkflowAsync(workflows[0].Key);
        }
    }

    private async Task LoadUiLayoutsAsync()
    {
        if (Services.GetService<UiApiClient>() is { } uiClient)
        {
            var resp = await uiClient.ListAsync();
            if (resp.IsSuccess && resp.Data is not null)
            {
                uiLayouts = resp.Data;
            }
        }
    }

    private void OpenToolbarScreenDesigner()
    {
        if (FindState(selectedNodeKey) is { } stObj && GetString(stObj, "type") != "SubFlow")
        {
            var existingKey = GetNestedString(stObj, "view", "layout");
            if (!string.IsNullOrWhiteSpace(existingKey))
            {
                OpenScreenDesignerForState(stObj, existingKey);
                return;
            }

            CreateAndBindNewScreenForState(stObj);
            return;
        }

        screenModalTargetStateKey = null;
        screenModalKey = uiLayouts.FirstOrDefault()?.Key;
        screenModalDoc = null;
        screenModalSession++;
        screenModalOpen = true;
    }

    private void OpenScreenDesignerForState(JsonObject stateObj, string layoutKey)
    {
        screenModalTargetStateKey = GetString(stateObj, "key");
        screenModalKey = layoutKey.Trim();
        screenModalDoc = null;
        screenModalSession++;
        screenModalOpen = true;
    }

    private void CreateAndBindNewScreenForState(JsonObject stateObj)
    {
        var wfKey = GetString(doc, "key") ?? "workflow";
        var stKey = GetString(stateObj, "key") ?? "state";
        var stTitle = GetString(stateObj, "title") ?? stKey;
        var newLayoutKey = $"{wfKey}-{stKey}-view";

        var items = new JsonArray();
        if (doc["dataSchema"] is JsonObject schemaObj && schemaObj["properties"] is JsonObject propsObj && propsObj.Count > 0)
        {
            foreach (var (field, node) in propsObj)
            {
                if (node is JsonObject fSpec)
                {
                    var fTitle = GetString(fSpec, "title") ?? field;
                    var fType = GetString(fSpec, "type") ?? "string";
                    var row = new JsonObject
                    {
                        ["label"] = fTitle,
                        ["value"] = $"{{{{ data.{field} }}}}",
                        ["visibleWhen"] = $"data.{field} != null",
                    };
                    if (fType == "number")
                    {
                        row["format"] = "N2";
                    }

                    items.Add(row);
                }
            }
        }
        else
        {
            items.Add(new JsonObject { ["label"] = "Başlık", ["value"] = "{{ data.title }}" });
        }

        var generatedDoc = new UiLayoutDocument
        {
            Key = newLayoutKey,
            Title = $"{stTitle} Ekranı",
            Kind = UiLayoutKind.View,
            Body =
            [
                new UiNode
                {
                    Widget = "section",
                    Props = new JsonObject { ["title"] = $"{stTitle} — Kayıt Özeti" },
                    Children =
                    [
                        new UiNode
                        {
                            Widget = "fields",
                            Props = new JsonObject { ["items"] = items },
                        },
                    ],
                },
                new UiNode
                {
                    Widget = "layout",
                    Props = new JsonObject { ["key"] = "workflow-footer" },
                },
            ],
        };

        SetNestedString(stateObj, "view", "layout", newLayoutKey);
        SyncJsonFromDoc();

        screenModalTargetStateKey = stKey;
        screenModalKey = newLayoutKey;
        screenModalDoc = generatedDoc;
        screenModalSession++;
        screenModalOpen = true;
    }

    private async Task OnScreenModalSavedAsync(string savedLayoutKey)
    {
        await LoadUiLayoutsAsync();
        if (!string.IsNullOrWhiteSpace(screenModalTargetStateKey) && FindState(screenModalTargetStateKey) is { } stObj)
        {
            SetNestedString(stObj, "view", "layout", savedLayoutKey);
            SyncJsonFromDoc();
        }
    }

    private void NavigateToStandaloneScreenDesigner(string layoutKey)
    {
        var wfKey = GetString(doc, "key") ?? string.Empty;
        var url = $"/ui-admin?key={Uri.EscapeDataString(layoutKey.Trim())}";
        if (!string.IsNullOrWhiteSpace(wfKey))
        {
            url += $"&workflow={Uri.EscapeDataString(wfKey)}";
        }

        Navigation.NavigateTo(url);
    }

    private IEnumerable<IGrouping<string, WorkflowTaskSpecModel>> FilteredTaskGroups()
    {
        var filter = paletteFilter.Trim();
        var query = string.IsNullOrEmpty(filter)
            ? taskSpecs
            : taskSpecs.Where(t =>
                t.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                t.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                t.Category.Contains(filter, StringComparison.OrdinalIgnoreCase));
        return query.GroupBy(t => t.Category);
    }

    // --- Mouse / Pointer Canvas Interactions (Pan, Move Group, Draw Arrow, Marquee Lasso) ---

    private string GetStudioBodyClass() =>
        (showPalette, showInspector) switch
        {
            (true, true) => "middt-wf-studio-body",
            (false, true) => "middt-wf-studio-body middt-wf-studio-body-no-left",
            (true, false) => "middt-wf-studio-body middt-wf-studio-body-no-right",
            (false, false) => "middt-wf-studio-body middt-wf-studio-body-full",
        };

    private string GetViewportClass()
    {
        if (pointerMode == "pan")
        {
            return "middt-wf-viewport middt-wf-viewport-pan middt-wf-viewport-panning";
        }

        return toolMode == "pan"
            ? "middt-wf-viewport middt-wf-viewport-pan"
            : "middt-wf-viewport middt-wf-viewport-select";
    }

    private void ResetViewport()
    {
        panX = 0;
        panY = 0;
        zoom = 1.0;
    }

    private void StartPan(PointerEventArgs e)
    {
        pointerMode = "pan";
        pointerMoved = false;
        pointerStartClientX = e.ClientX;
        pointerStartClientY = e.ClientY;
        panStartX = panX;
        panStartY = panY;
    }

    private void OnViewportPointerDown(PointerEventArgs e)
    {
        if (toolMode == "pan" || e.Button == 1 || e.AltKey)
        {
            StartPan(e);
            return;
        }

        if (e.Button != 0)
        {
            return;
        }

        if (!e.ShiftKey && !e.CtrlKey && !e.MetaKey)
        {
            selectedNodeKeys.Clear();
            selectedEdgeIds.Clear();
            selectedTaskIndex = -1;
            selectedTransitionIndex = -1;
        }

        pointerMode = "lasso";
        pointerMoved = false;
        pointerStartClientX = e.ClientX;
        pointerStartClientY = e.ClientY;
        lassoStartX = Math.Max(0, (e.OffsetX - panX) / zoom);
        lassoStartY = Math.Max(0, (e.OffsetY - panY) / zoom);
        lassoCurrentX = lassoStartX;
        lassoCurrentY = lassoStartY;
    }

    private void OnBoardPointerDown(PointerEventArgs e)
    {
        if (toolMode == "pan" || e.Button == 1 || e.AltKey)
        {
            StartPan(e);
            return;
        }

        if (e.Button != 0)
        {
            return;
        }

        // Start rubber-band / marquee selection on empty board
        if (!e.ShiftKey && !e.CtrlKey && !e.MetaKey)
        {
            selectedNodeKeys.Clear();
            selectedEdgeIds.Clear();
            selectedTaskIndex = -1;
            selectedTransitionIndex = -1;
        }

        pointerMode = "lasso";
        pointerMoved = false;
        pointerStartClientX = e.ClientX;
        pointerStartClientY = e.ClientY;
        lassoStartX = Math.Max(0, e.OffsetX);
        lassoStartY = Math.Max(0, e.OffsetY);
        lassoCurrentX = lassoStartX;
        lassoCurrentY = lassoStartY;
    }

    private void OnNodeHeaderPointerDown(PointerEventArgs e, string nodeKey)
    {
        if (toolMode == "pan" || e.Button == 1 || e.AltKey)
        {
            StartPan(e);
            return;
        }

        if (e.Button != 0)
        {
            return;
        }

        if (e.ShiftKey || e.CtrlKey || e.MetaKey)
        {
            if (!selectedNodeKeys.Remove(nodeKey))
            {
                selectedNodeKeys.Add(nodeKey);
            }
        }
        else if (!selectedNodeKeys.Contains(nodeKey))
        {
            selectedNodeKeys.Clear();
            selectedEdgeIds.Clear();
            selectedNodeKeys.Add(nodeKey);
        }

        selectedNodeKey = nodeKey;
        selectedTaskIndex = -1;
        selectedTransitionIndex = -1;

        pointerMode = "move-nodes";
        pointerSourceNodeKey = nodeKey;
        pointerMoved = false;
        pointerStartClientX = e.ClientX;
        pointerStartClientY = e.ClientY;
        moveInitialPositions.Clear();
        foreach (var k in selectedNodeKeys)
        {
            moveInitialPositions[k] = GetNodePos(k);
        }
    }

    private void OnOutputPortPointerDown(PointerEventArgs e, string fromNodeKey)
    {
        if (e.Button != 0)
        {
            return;
        }

        var pos = GetNodePos(fromNodeKey);
        var width = fromNodeKey == StartNodeKey ? StartNodeWidth : StateNodeWidth;
        pointerMode = "connect-wire";
        pointerSourceNodeKey = fromNodeKey;
        pointerMoved = false;
        pointerStartClientX = e.ClientX;
        pointerStartClientY = e.ClientY;
        wireStartX = pos.X + width;
        wireStartY = pos.Y + PortOffsetY;
        wireCursorX = wireStartX;
        wireCursorY = wireStartY;
        hoverConnectTargetKey = null;
    }

    private void OnBoardPointerMove(PointerEventArgs e)
    {
        if (pointerMode is null)
        {
            return;
        }

        var rawDx = e.ClientX - pointerStartClientX;
        var rawDy = e.ClientY - pointerStartClientY;
        if (Math.Abs(rawDx) > 3 || Math.Abs(rawDy) > 3)
        {
            pointerMoved = true;
        }

        if (pointerMode == "pan")
        {
            panX = Math.Clamp(panStartX + rawDx, -2400, 900);
            panY = Math.Clamp(panStartY + rawDy, -1600, 700);
        }
        else if (pointerMode == "move-nodes")
        {
            var dx = rawDx / zoom;
            var dy = rawDy / zoom;
            foreach (var (key, initPos) in moveInitialPositions)
            {
                var nx = Math.Max(16, Snap(initPos.X + dx));
                var ny = Math.Max(16, Snap(initPos.Y + dy));
                SetNodePos(key, nx, ny);
            }
        }
        else if (pointerMode == "connect-wire")
        {
            wireCursorX = wireStartX + (rawDx / zoom);
            wireCursorY = wireStartY + (rawDy / zoom);
            hoverConnectTargetKey = FindStateAtPoint(wireCursorX, wireCursorY);
        }
        else if (pointerMode == "lasso")
        {
            lassoCurrentX = Math.Max(0, lassoStartX + (rawDx / zoom));
            lassoCurrentY = Math.Max(0, lassoStartY + (rawDy / zoom));
            UpdateLassoSelection();
        }
    }

    private void OnBoardPointerUp(PointerEventArgs e)
    {
        if (pointerMode == "move-nodes")
        {
            if (pointerMoved)
            {
                SyncJsonFromDoc();
            }
            else if (pointerSourceNodeKey is not null && !e.ShiftKey && !e.CtrlKey && !e.MetaKey)
            {
                SelectSingleState(pointerSourceNodeKey);
            }
        }
        else if (pointerMode == "connect-wire" && pointerSourceNodeKey is not null)
        {
            var targetKey = hoverConnectTargetKey ?? FindStateAtPoint(wireCursorX, wireCursorY);
            if (!string.IsNullOrEmpty(targetKey))
            {
                CompleteConnection(pointerSourceNodeKey, targetKey);
            }
        }

        ResetPointerState();
    }

    private void OnNodePointerEnter(string stateKey)
    {
        if (pointerMode == "connect-wire")
        {
            hoverConnectTargetKey = stateKey;
        }
    }

    private void OnNodePointerLeave(string stateKey)
    {
        if (hoverConnectTargetKey == stateKey)
        {
            hoverConnectTargetKey = null;
        }
    }

    private void OnNodePointerUp(PointerEventArgs e, string targetStateKey)
    {
        if (pointerMode == "connect-wire" && pointerSourceNodeKey is not null)
        {
            CompleteConnection(pointerSourceNodeKey, targetStateKey);
            ResetPointerState();
            return;
        }

        if (pointerMode == "move-nodes")
        {
            if (pointerMoved)
            {
                SyncJsonFromDoc();
            }
            else if (pointerSourceNodeKey is not null && !e.ShiftKey && !e.CtrlKey && !e.MetaKey)
            {
                SelectSingleState(pointerSourceNodeKey);
            }
        }

        ResetPointerState();
    }

    private void ResetPointerState()
    {
        pointerMode = null;
        pointerSourceNodeKey = null;
        hoverConnectTargetKey = null;
        pointerMoved = false;
        moveInitialPositions.Clear();
    }

    private string? FindStateAtPoint(double x, double y)
    {
        foreach (var st in GetStates())
        {
            var k = GetString(st, "key");
            if (string.IsNullOrEmpty(k))
            {
                continue;
            }

            var pos = GetNodePos(k);
            if (x >= pos.X - 16 && x <= pos.X + StateNodeWidth + 16 &&
                y >= pos.Y - 12 && y <= pos.Y + NodeApproxHeight + 12)
            {
                return k;
            }
        }

        return null;
    }

    private void UpdateLassoSelection()
    {
        var minX = Math.Min(lassoStartX, lassoCurrentX);
        var maxX = Math.Max(lassoStartX, lassoCurrentX);
        var minY = Math.Min(lassoStartY, lassoCurrentY);
        var maxY = Math.Max(lassoStartY, lassoCurrentY);

        selectedNodeKeys.Clear();
        foreach (var st in GetStates())
        {
            var k = GetString(st, "key");
            if (string.IsNullOrEmpty(k))
            {
                continue;
            }

            var pos = GetNodePos(k);
            var intersects = pos.X < maxX && (pos.X + StateNodeWidth) > minX &&
                             pos.Y < maxY && (pos.Y + NodeApproxHeight) > minY;
            if (intersects)
            {
                selectedNodeKeys.Add(k);
                selectedNodeKey = k;
            }
        }

        selectedEdgeIds.Clear();
        foreach (var edge in BuildAllEdges())
        {
            if (edge.Geometry.MidX >= minX && edge.Geometry.MidX <= maxX &&
                edge.Geometry.MidY >= minY && edge.Geometry.MidY <= maxY)
            {
                selectedEdgeIds.Add(edge.EdgeId);
            }
        }
    }

    private void SelectSingleState(string nodeKey)
    {
        selectedNodeKeys.Clear();
        selectedEdgeIds.Clear();
        selectedNodeKeys.Add(nodeKey);
        selectedNodeKey = nodeKey;
        selectedTaskIndex = -1;
        selectedTransitionIndex = -1;
    }

    private void OnEdgeClick(MouseEventArgs e, string fromKey, int transitionIndex)
    {
        var edgeId = MakeEdgeId(fromKey, transitionIndex);
        if (e.ShiftKey || e.CtrlKey || e.MetaKey)
        {
            if (!selectedEdgeIds.Remove(edgeId))
            {
                selectedEdgeIds.Add(edgeId);
            }
        }
        else
        {
            selectedNodeKeys.Clear();
            selectedEdgeIds.Clear();
            selectedEdgeIds.Add(edgeId);
        }

        SelectTransition(fromKey, transitionIndex);
    }

    private void OnCanvasKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Delete" or "Backspace")
        {
            DeleteSelection();
        }
        else if (e.Key == "Escape")
        {
            ClearSelection();
            ResetPointerState();
        }
    }

    // --- Group Operations (Select All, Align, Duplicate, Delete Group) ---

    private void SelectAllOnBoard()
    {
        selectedNodeKeys.Clear();
        foreach (var st in GetStates())
        {
            if (GetString(st, "key") is { Length: > 0 } k)
            {
                selectedNodeKeys.Add(k);
            }
        }

        selectedEdgeIds.Clear();
        foreach (var edge in BuildAllEdges())
        {
            selectedEdgeIds.Add(edge.EdgeId);
        }
    }

    private void ClearSelection()
    {
        selectedNodeKeys.Clear();
        selectedEdgeIds.Clear();
        selectedTaskIndex = -1;
        selectedTransitionIndex = -1;
    }

    private void DeleteSelection()
    {
        var changedAny = false;

        // 1. Delete selected edges (in reverse index order per state so indices stay valid)
        var edgesToDelete = selectedEdgeIds
            .Select(ParseEdgeId)
            .Where(x => x is not null)
            .Select(x => x!.Value)
            .GroupBy(x => x.FromKey)
            .ToList();

        foreach (var grp in edgesToDelete)
        {
            if (FindState(grp.Key) is { } stObj && stObj["transitions"] is JsonArray trArr)
            {
                foreach (var idx in grp.Select(g => g.Index).OrderByDescending(i => i))
                {
                    if (idx >= 0 && idx < trArr.Count)
                    {
                        trArr.RemoveAt(idx);
                        changedAny = true;
                    }
                }
            }
        }

        // 2. Delete selected states (except StartNodeKey)
        var statesToDelete = selectedNodeKeys.Where(k => k != StartNodeKey).ToHashSet(StringComparer.Ordinal);
        if (statesToDelete.Count > 0)
        {
            var statesArr = EnsureArray(doc, "states");
            for (var i = statesArr.Count - 1; i >= 0; i--)
            {
                if (statesArr[i] is JsonObject st && GetString(st, "key") is { } k && statesToDelete.Contains(k))
                {
                    statesArr.RemoveAt(i);
                    nodePositions.Remove(k);
                    (doc["x-layout"] as JsonObject)?.Remove(k);
                    changedAny = true;
                }
            }

            // Also remove dangling transitions pointing to deleted states
            foreach (var st in GetStates())
            {
                if (st["transitions"] is JsonArray trArr)
                {
                    for (var i = trArr.Count - 1; i >= 0; i--)
                    {
                        if (trArr[i] is JsonObject tr && GetString(tr, "target") is { } tgt && statesToDelete.Contains(tgt))
                        {
                            trArr.RemoveAt(i);
                        }
                    }
                }
            }
        }

        selectedNodeKeys.Clear();
        selectedEdgeIds.Clear();
        selectedNodeKey = StartNodeKey;
        selectedTransitionIndex = -1;
        selectedTaskIndex = -1;

        if (changedAny)
        {
            SyncJsonFromDoc();
        }
    }

    private void RemoveSingleEdge(string fromKey, int transitionIndex)
    {
        if (FindState(fromKey) is not { } stObj)
        {
            return;
        }

        var trs = EnsureArray(stObj, "transitions");
        if (transitionIndex >= 0 && transitionIndex < trs.Count)
        {
            trs.RemoveAt(transitionIndex);
            selectedEdgeIds.Remove(MakeEdgeId(fromKey, transitionIndex));
            if (selectedNodeKey == fromKey && selectedTransitionIndex == transitionIndex)
            {
                selectedTransitionIndex = -1;
            }

            SyncJsonFromDoc();
        }
    }

    private void AlignSelectedHorizontal()
    {
        var keys = selectedNodeKeys.Where(k => k != StartNodeKey).ToList();
        if (keys.Count < 2)
        {
            return;
        }

        var avgY = Snap(keys.Average(k => GetNodePos(k).Y));
        var ordered = keys.OrderBy(k => GetNodePos(k).X).ToList();
        var startX = GetNodePos(ordered[0]).X;
        for (var i = 0; i < ordered.Count; i++)
        {
            SetNodePos(ordered[i], Snap(startX + (i * 340)), avgY);
        }

        SyncJsonFromDoc();
    }

    private void AlignSelectedVertical()
    {
        var keys = selectedNodeKeys.Where(k => k != StartNodeKey).ToList();
        if (keys.Count < 2)
        {
            return;
        }

        var avgX = Snap(keys.Average(k => GetNodePos(k).X));
        var ordered = keys.OrderBy(k => GetNodePos(k).Y).ToList();
        var startY = GetNodePos(ordered[0]).Y;
        for (var i = 0; i < ordered.Count; i++)
        {
            SetNodePos(ordered[i], avgX, Snap(startY + (i * 250)));
        }

        SyncJsonFromDoc();
    }

    private void DuplicateSelectedStates()
    {
        var keys = selectedNodeKeys.Where(k => k != StartNodeKey).ToList();
        if (keys.Count == 0)
        {
            return;
        }

        var statesArr = EnsureArray(doc, "states");
        var newSelection = new HashSet<string>(StringComparer.Ordinal);
        foreach (var k in keys)
        {
            if (FindState(k) is not { } orig || orig.DeepClone() is not JsonObject clone)
            {
                continue;
            }

            var newKey = $"{k}-copy";
            var suffix = 2;
            while (FindState(newKey) is not null)
            {
                newKey = $"{k}-copy-{suffix++}";
            }

            clone["key"] = newKey;
            clone["title"] = $"{GetString(orig, "title") ?? k} (Kopya)";
            statesArr.Add(clone);

            var pos = GetNodePos(k);
            SetNodePos(newKey, pos.X + 48, pos.Y + 48);
            newSelection.Add(newKey);
            selectedNodeKey = newKey;
        }

        selectedNodeKeys = newSelection;
        selectedEdgeIds.Clear();
        SyncJsonFromDoc();
    }

    private static string MakeEdgeId(string fromKey, int index) => $"{fromKey}::{index}";

    private static (string FromKey, int Index)? ParseEdgeId(string edgeId)
    {
        var sep = edgeId.LastIndexOf("::", StringComparison.Ordinal);
        if (sep <= 0 || !int.TryParse(edgeId.AsSpan(sep + 2), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx))
        {
            return null;
        }

        return (edgeId[..sep], idx);
    }

    private bool IsEdgeSelected(string edgeId)
    {
        if (selectedEdgeIds.Contains(edgeId))
        {
            return true;
        }

        return ParseEdgeId(edgeId) is { } p && selectedNodeKey == p.FromKey && selectedTransitionIndex == p.Index;
    }

    private string ComputePreviewWirePath(string fromKey, double targetX, double targetY)
    {
        var fromPos = GetNodePos(fromKey);
        var fromWidth = fromKey == StartNodeKey ? StartNodeWidth : StateNodeWidth;
        var x1 = fromPos.X + fromWidth;
        var y1 = fromPos.Y + PortOffsetY;
        var dx = Math.Max(60.0, Math.Abs(targetX - x1) * 0.45);
        var cx1 = x1 + dx;
        var cy1 = y1;
        var cx2 = targetX - dx;
        var cy2 = targetY;
        return FormattableString.Invariant($"M {x1:0.#} {y1:0.#} C {cx1:0.#} {cy1:0.#}, {cx2:0.#} {cy2:0.#}, {targetX:0.#} {targetY:0.#}");
    }

