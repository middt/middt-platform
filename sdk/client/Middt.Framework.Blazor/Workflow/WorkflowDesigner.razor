    private string CreateStateOnBoard(string type, string subType, string title, double x, double y)
    {
        var states = EnsureArray(doc, "states");
        var idx = states.Count + 1;
        var key = $"state-{idx}";
        while (FindState(key) is not null)
        {
            idx++;
            key = $"state-{idx}";
        }

        var newState = new JsonObject
        {
            ["key"] = key,
            ["title"] = title,
            ["type"] = type,
            ["subType"] = subType,
            ["step"] = idx,
        };
        if (type == "SubFlow")
        {
            var firstOther = workflows.FirstOrDefault(w => !string.Equals(w.Key, GetString(doc, "key"), StringComparison.Ordinal))?.Key ?? string.Empty;
            newState["subFlow"] = new JsonObject
            {
                ["workflow"] = firstOther,
                ["outputInto"] = "subFlowResult",
                ["forwardTransitions"] = true,
            };
        }

        if (type != "Finish")
        {
            newState["onEntry"] = new JsonArray();
            newState["transitions"] = new JsonArray();
        }

        states.Add(newState);
        SetNodePos(key, x, y);
        selectedNodeKeys.Clear();
        selectedEdgeIds.Clear();
        selectedNodeKeys.Add(key);
        SelectState(key);
        SyncJsonFromDoc();
        return key;
    }

