    private void RenameState(JsonObject stateObj, string? newKey)
    {
        if (string.IsNullOrWhiteSpace(newKey))
        {
            return;
        }

        var trimmed = newKey.Trim();
        var oldKey = GetString(stateObj, "key");
        stateObj["key"] = trimmed;

        if (!string.IsNullOrEmpty(oldKey))
        {
            if (nodePositions.Remove(oldKey, out var pos))
            {
                SetNodePos(trimmed, pos.X, pos.Y);
                (doc["x-layout"] as JsonObject)?.Remove(oldKey);
            }

            if (selectedNodeKeys.Remove(oldKey))
            {
                selectedNodeKeys.Add(trimmed);
            }

            if (doc["start"] is JsonObject startObj && GetString(startObj, "target") == oldKey)
            {
                startObj["target"] = trimmed;
            }

            foreach (var st in GetStates())
            {
                if (st["transitions"] is JsonArray trArr)
                {
                    foreach (var tr in trArr.OfType<JsonObject>())
                    {
                        if (GetString(tr, "target") == oldKey)
                        {
                            tr["target"] = trimmed;
                        }
                    }
                }
            }
        }

        selectedNodeKey = trimmed;
        SyncJsonFromDoc();
    }

    private void AddTransition(JsonObject stateObj)
    {
        var transitions = EnsureArray(stateObj, "transitions");
        var states = GetStates();
        var defaultTarget = states.Select(s => GetString(s, "key")).FirstOrDefault(k => !string.IsNullOrEmpty(k)) ?? "$self";
        transitions.Add(new JsonObject
        {
            ["key"] = $"transition-{transitions.Count + 1}",
            ["title"] = "Devam Et",
            ["target"] = defaultTarget,
            ["trigger"] = "Manual",
        });
        selectedTransitionIndex = transitions.Count - 1;
        selectedTaskIndex = -1;
        SyncJsonFromDoc();
    }

    private void ChangeTaskType(JsonObject taskObj, string? newType)
    {
