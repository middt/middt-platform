        {
            return;
        }

        taskObj["task"] = newType;
        var spec = taskSpecs.FirstOrDefault(s => string.Equals(s.Name, newType, StringComparison.OrdinalIgnoreCase));
        taskObj["config"] = spec?.Template.DeepClone() as JsonObject ?? new JsonObject();
        SyncJsonFromDoc();
    }

    private void SetErrorAction(JsonObject taskObj, string? action)
    {
        if (string.IsNullOrWhiteSpace(action) || action is "Fault" or "Fail")
        {
            if (taskObj["onError"] is JsonObject existing)
            {
                existing.Remove("action");
                existing.Remove("transition");
                if (existing.Count == 0 || (GetInt(existing, "maxAttempts", 1) <= 1))
                {
                    taskObj.Remove("onError");
                }
            }
        }
        else
        {
            var err = EnsureObject(taskObj, "onError");
            err["action"] = action;
            if (action != "Transition")
            {
                err.Remove("transition");
            }
        }

        SyncJsonFromDoc();
    }

    private void SetErrorAttempts(JsonObject taskObj, string? raw)
    {
        var attempts = int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed)
            ? Math.Max(1, parsed)
            : 1;
        if (attempts <= 1 && (taskObj["onError"] is not JsonObject existing || (GetString(existing, "action") ?? "Fault") == "Fault"))
        {
            taskObj.Remove("onError");
        }
        else
        {
            var err = EnsureObject(taskObj, "onError");
            err["maxAttempts"] = attempts;
            if (err["delay"] is null)
            {
                err["delay"] = "00:00:05";
            }
        }

        SyncJsonFromDoc();
    }

    private void SetErrorDelay(JsonObject taskObj, string? delay)
    {
        var err = EnsureObject(taskObj, "onError");
        SetString(err, "delay", delay ?? "00:00:01");
        SyncJsonFromDoc();
    }

    private void AddSchemaField()
    {
        var name = newSchemaFieldName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            return;
        }

        var schemaObj = EnsureObject(doc, "dataSchema");
        schemaObj["type"] = "object";
        var props = EnsureObject(schemaObj, "properties");
        props[name] = new JsonObject
        {
            ["type"] = "string",
            ["title"] = name,
            ["x-search"] = true,
            ["x-list"] = true,
        };
        newSchemaFieldName = string.Empty;
        SyncJsonFromDoc();
    }

    private void RemoveSchemaField(string fieldName)
    {
        if (doc["dataSchema"] is JsonObject schemaObj)
        {
            (schemaObj["properties"] as JsonObject)?.Remove(fieldName);
            if (schemaObj["required"] is JsonArray reqArr)
            {
                for (var i = reqArr.Count - 1; i >= 0; i--)
                {
                    if (reqArr[i]?.GetValue<string>() == fieldName)
                    {
                        reqArr.RemoveAt(i);
                    }
                }
            }
        }

        SyncJsonFromDoc();
    }

    private void ToggleRequiredField(JsonArray reqArr, string fieldName, bool isRequired)
    {
        for (var i = reqArr.Count - 1; i >= 0; i--)
        {
            if (reqArr[i]?.GetValue<string>() == fieldName)
            {
                reqArr.RemoveAt(i);
            }
        }

        if (isRequired)
        {
            reqArr.Add(fieldName);
        }

        SyncJsonFromDoc();
    }

    private void OnRawJsonInput(ChangeEventArgs e)
    {
        json = e.Value?.ToString() ?? string.Empty;
        TryParseRawJson();
    }

    private bool TryParseRawJson()
    {
        try
        {
            if (JsonNode.Parse(json) is JsonObject parsed)
            {
                doc = parsed;
                EnsureNodePositions(forceAutoLayout: false);
                errors.Clear();
                return true;
            }

            errors = ["İş akışı tanımı bir JSON nesnesi ({ ... }) olmalıdır."];
            return false;
        }
        catch (JsonException ex)
        {
            errors = [$"JSON sözdizimi hatası: {ex.Message}"];
            return false;
        }
    }

    private void FormatJson()
    {
        if (TryParseRawJson())
        {
            SyncJsonFromDoc();
        }
    }

    private void SyncJsonFromDoc()
    {
        json = doc.ToJsonString(PrettyJson);
        validMessage = null;
    }

    private async Task ValidateAsync()
    {
        errors.Clear();
        validMessage = null;
        if (!TryParseRawJson())
        {
            return;
        }

        var resp = await Client.ValidateDefinitionAsync(doc);
        if (!resp.IsSuccess || resp.Data is null)
        {
            errors.AddRange(resp.MessageList);
            return;
        }

        if (resp.Data.IsValid)
        {
            validMessage = "✔ İş akışı tanımı, geçiş hedefleri ve tüm C# ifadeleri geçerli.";
        }
        else
        {
            errors.AddRange(resp.Data.Errors);
        }
    }

    private async Task SaveAsync()
    {
        errors.Clear();
        validMessage = null;
        if (!TryParseRawJson())
        {
            return;
        }

        var key = GetString(doc, "key")?.Trim();
        if (string.IsNullOrWhiteSpace(key))
        {
            errors.Add("İş akışı anahtarı (key) zorunludur.");
            return;
        }

        busy = true;
        try
        {
            var resp = await Client.SaveDefinitionAsync(key, doc);
            if (!resp.IsSuccess)
            {
                errors.AddRange(resp.MessageList);
                return;
            }

            selectedWorkflowKey = key;
            validMessage = $"✔ '{key}' iş akışı kaydedildi ve çalışma zamanında devreye alındı.";
            Notification.Notify(NotificationSeverity.Success, "Kaydedildi", $"'{key}' iş akışı güncellendi.");

            var listResp = await Client.ListWorkflowsAsync();
            if (listResp.IsSuccess)
            {
                workflows = listResp.Data ?? [];
            }

            await OnChanged.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // --- Static Helpers ---

    private List<JsonObject> GetStates() =>
        doc["states"] is JsonArray arr ? arr.OfType<JsonObject>().ToList() : [];

    private JsonObject? FindState(string? key) =>
        string.IsNullOrWhiteSpace(key) ? null : GetStates().FirstOrDefault(s => GetString(s, "key") == key);

    private static JsonObject EnsureObject(JsonObject parent, string prop)
    {
        if (parent[prop] is JsonObject obj)
        {
            return obj;
        }

        var created = new JsonObject();
        parent[prop] = created;
        return created;
    }

    private static JsonArray EnsureArray(JsonObject parent, string prop)
    {
        if (parent[prop] is JsonArray arr)
        {
            return arr;
        }

        var created = new JsonArray();
        parent[prop] = created;
        return created;
    }

    private static string? GetString(JsonObject obj, string prop) =>
        obj[prop] is JsonValue val && val.TryGetValue<string>(out var s) ? s : null;

    private static void SetString(JsonObject obj, string prop, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            obj.Remove(prop);
        }
        else
        {
            obj[prop] = value.Trim();
        }
    }

    private static string? GetNestedString(JsonObject obj, string parentProp, string childProp) =>
        obj[parentProp] is JsonObject p ? GetString(p, childProp) : null;

    private static void SetNestedString(JsonObject obj, string parentProp, string childProp, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            if (obj[parentProp] is JsonObject p)
            {
                p.Remove(childProp);
                if (p.Count == 0)
                {
                    obj.Remove(parentProp);
                }
            }
        }
        else
        {
            EnsureObject(obj, parentProp)[childProp] = value.Trim();
        }
    }

    private static int GetInt(JsonObject obj, string prop, int fallback) =>
        obj[prop] is JsonValue val && val.TryGetValue<int>(out var i) ? i : fallback;

    private static int? GetIntNullable(JsonObject obj, string prop) =>
        obj[prop] is JsonValue val && val.TryGetValue<int>(out var i) ? i : null;

    private static void SetInt(JsonObject obj, string prop, string? raw, int fallback) =>
        obj[prop] = int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var i) ? i : fallback;

    private static void SetIntNullable(JsonObject obj, string prop, string? raw)
    {
        if (int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var i))
        {
            obj[prop] = i;
        }
        else
        {
            obj.Remove(prop);
        }
    }

    private static bool GetBool(JsonObject obj, string prop) =>
        obj[prop] is JsonValue val && val.TryGetValue<bool>(out var b) && b;

    private static void SetBool(JsonObject obj, string prop, bool value)
    {
        if (value)
        {
            obj[prop] = true;
        }
        else
        {
            obj.Remove(prop);
        }
    }

    private static string GetCsvArray(JsonObject obj, string prop) =>
        obj[prop] is JsonArray arr
            ? string.Join(", ", arr.Select(x => x?.GetValue<string>()).Where(s => !string.IsNullOrWhiteSpace(s)))
            : string.Empty;

    private static void SetCsvArray(JsonObject obj, string prop, string? csv)
    {
        var items = (csv ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .ToArray();
        if (items.Length == 0)
        {
            obj.Remove(prop);
        }
        else
        {
            obj[prop] = new JsonArray(items.Select(s => (JsonNode)JsonValue.Create(s)!).ToArray());
        }
    }

    private string GetAccessMode() =>
        GetNestedString(doc, "instanceAccess", "mode") ?? "all";

    private void SetAccessMode(string? mode)
    {
        if (string.IsNullOrWhiteSpace(mode) || mode == "all")
        {
            doc.Remove("instanceAccess");
        }
        else
        {
            EnsureObject(doc, "instanceAccess")["mode"] = mode;
        }

        SyncJsonFromDoc();
    }

    private static string? GetNodeRawText(JsonObject obj, string prop) =>
        obj[prop]?.ToJsonString();

    private static string GetJsonParamText(JsonObject cfg, string prop) =>
        cfg[prop] is { } node ? node.ToJsonString(PrettyJson) : string.Empty;

    private static void SetJsonParam(JsonObject cfg, string prop, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            cfg.Remove(prop);
            return;
        }

        try
        {
            cfg[prop] = JsonNode.Parse(raw);
        }
        catch (JsonException)
        {
            cfg[prop] = raw;
        }
    }

    private static void ReplaceObjectFromJson(JsonObject parent, string prop, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            parent[prop] = new JsonObject();
            return;
        }

        try
        {
            if (JsonNode.Parse(raw) is JsonObject parsed)
            {
                parent[prop] = parsed;
            }
        }
        catch (JsonException)
        {
            // Keep existing object if invalid
        }
    }

    private string GetStartNodeClass()
    {
        var cls = "middt-wf-board-node middt-wf-board-node-start";
        if (selectedNodeKeys.Contains(StartNodeKey) && selectedNodeKeys.Count > 1)
        {
            cls += " middt-wf-board-node-multi";
        }
        else if (selectedNodeKey == StartNodeKey || selectedNodeKeys.Contains(StartNodeKey))
        {
            cls += " middt-wf-board-node-selected";
        }

        return cls;
    }

    private string GetBoardNodeClass(string stateKey, string stateType, string stateSubType)
    {
        var cls = "middt-wf-board-node";
        if (stateType == "Finish")
        {
            cls += stateSubType is "Error" or "Cancelled" or "Timeout"
                ? " middt-wf-board-node-finish-error"
                : " middt-wf-board-node-finish-success";
        }

        if (hoverConnectTargetKey == stateKey)
        {
            cls += " middt-wf-board-node-connect-target";
        }
        else if (selectedNodeKeys.Contains(stateKey) && selectedNodeKeys.Count > 1)
        {
            cls += " middt-wf-board-node-multi";
        }
        else if (selectedNodeKey == stateKey || selectedNodeKeys.Contains(stateKey))
        {
            cls += " middt-wf-board-node-selected";
        }

        return cls;
    }

    private static string StateBadgeClass(string stateType, string stateSubType) =>
        (stateType, stateSubType) switch
        {
            ("Finish", "Success") => "middt-ui-badge-success",
            ("Finish", "Error" or "Timeout") => "middt-ui-badge-danger",
            ("Finish", "Cancelled") => "middt-ui-badge-warning",
            (_, "Human") => "middt-ui-badge-primary",
            _ => "middt-ui-badge-info",
        };

    private static string TriggerIcon(string? trigger) =>
        trigger switch
        {
            "Automatic" => "⚡",
            "Scheduled" => "⏱️",
            "Event" => "📨",
            _ => "👆",
        };

    private static string TaskSummary(JsonObject taskObj)
    {
        var type = GetString(taskObj, "task") ?? "set";
        var key = GetString(taskObj, "key") ?? type;
        return $"{key} ({type})";
    }

    private static string TaskBadges(JsonObject taskObj)
    {
        var parts = new List<string>();
        if (GetBool(taskObj, "background"))
        {
            parts.Add("bg");
        }

        if (!string.IsNullOrWhiteSpace(GetString(taskObj, "when")))
        {
            parts.Add("when");
        }

        if (taskObj["onError"] is JsonObject err && GetString(err, "action") is { } act && act != "Fail")
        {
            parts.Add(act);
        }

        return string.Join("·", parts);
    }

