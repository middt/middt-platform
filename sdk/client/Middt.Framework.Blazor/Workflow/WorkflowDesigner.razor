    private void EnsureNodePositions(bool forceAutoLayout)
    {
        var layoutObj = doc["x-layout"] as JsonObject;
        if (!forceAutoLayout && layoutObj is not null)
        {
            nodePositions.Clear();
            foreach (var kv in layoutObj)
            {
                if (kv.Value is JsonObject pt)
                {
                    var x = pt["x"]?.GetValue<double>() ?? 60;
                    var y = pt["y"]?.GetValue<double>() ?? 160;
                    nodePositions[kv.Key] = new NodePoint(x, y);
                }
            }
        }

        var states = GetStates();
        if (forceAutoLayout || !nodePositions.ContainsKey(StartNodeKey))
        {
            ComputeDagAutoLayout(states);
            return;
        }

        var nextCol = 1;
        foreach (var st in states)
        {
            var k = GetString(st, "key") ?? string.Empty;
            if (!string.IsNullOrEmpty(k) && !nodePositions.ContainsKey(k))
            {
                SetNodePos(k, 60 + (nextCol * 340), 140);
                nextCol++;
            }
        }
    }

    private void ComputeDagAutoLayout(List<JsonObject> states)
    {
        nodePositions.Clear();
        SetNodePos(StartNodeKey, 48, 96);

        var startTarget = GetNestedString(doc, "start", "target");
        var layers = new Dictionary<string, int>(StringComparer.Ordinal);
        var queue = new Queue<string>();

        if (!string.IsNullOrWhiteSpace(startTarget) && FindState(startTarget) is not null)
        {
            layers[startTarget] = 0;
            queue.Enqueue(startTarget);
        }

        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            var curLayer = layers[cur];
            if (FindState(cur) is { } stObj && stObj["transitions"] is JsonArray trArr)
            {
                foreach (var item in trArr.OfType<JsonObject>())
                {
                    var tgt = GetString(item, "target");
                    if (!string.IsNullOrWhiteSpace(tgt) && tgt != "$self" && !layers.ContainsKey(tgt) && FindState(tgt) is not null)
                    {
                        layers[tgt] = curLayer + 1;
                        queue.Enqueue(tgt);
                    }
                }
            }
        }

        var maxLayer = layers.Values.DefaultIfEmpty(0).Max();
        foreach (var st in states)
        {
            var k = GetString(st, "key") ?? string.Empty;
            if (!string.IsNullOrEmpty(k) && !layers.ContainsKey(k))
            {
                maxLayer++;
                layers[k] = maxLayer;
            }
        }

        foreach (var grp in layers.GroupBy(kv => kv.Value).OrderBy(g => g.Key))
        {
            var col = grp.Key;
            var keys = grp.Select(kv => kv.Key).ToList();
            var x = 352 + (col * 496);
            var curY = 80.0;
            for (var row = 0; row < keys.Count; row++)
            {
                var stKey = keys[row];
                SetNodePos(stKey, x, curY);
                var stObj = FindState(stKey);
                curY += EstimateStateNodeHeight(stObj) + 48.0;
            }
        }
    }

    private static double EstimateStateNodeHeight(JsonObject? stateObj)
    {
        if (stateObj is null)
        {
            return 220.0;
        }

        var onEntryCount = (stateObj["onEntry"] as JsonArray)?.Count ?? 0;
        var isFinish = string.Equals(GetString(stateObj, "type"), "Finish", StringComparison.Ordinal);
        var onExitCount = isFinish ? 0 : ((stateObj["onExit"] as JsonArray)?.Count ?? 0);
        var h = 150.0 + (Math.Max(1, onEntryCount) * 32.0) + (isFinish ? 0.0 : 52.0 + (Math.Max(1, onExitCount) * 32.0));
        return Math.Max(210.0, h);
    }

    private NodePoint GetNodePos(string nodeKey) =>
        nodePositions.TryGetValue(nodeKey, out var pt) ? pt : new NodePoint(80, 160);

    private void SetNodePos(string nodeKey, double x, double y)
    {
        var pt = new NodePoint(Snap(x), Snap(y));
        nodePositions[nodeKey] = pt;
        var layoutObj = EnsureObject(doc, "x-layout");
        layoutObj[nodeKey] = new JsonObject
        {
            ["x"] = pt.X,
            ["y"] = pt.Y,
        };
    }

    private static double Snap(double v) => Math.Round(v / 16.0) * 16.0;
    private static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    private List<CanvasEdge> BuildAllEdges()
    {
        var list = new List<CanvasEdge>();
        var states = GetStates();

        var pairCounts = new Dictionary<(string From, string Target), int>();
        foreach (var st in states)
        {
            var fromKey = GetString(st, "key") ?? string.Empty;
            if (st["transitions"] is not JsonArray trs)
            {
                continue;
            }

            foreach (var tr in trs.OfType<JsonObject>())
            {
                var rawTarget = GetString(tr, "target") ?? "$self";
                var resolvedTarget = rawTarget == "$self" ? fromKey : rawTarget;
                var pair = (fromKey, resolvedTarget);
                pairCounts[pair] = pairCounts.GetValueOrDefault(pair) + 1;
            }
        }

        var pairSeen = new Dictionary<(string From, string Target), int>();
        foreach (var st in states)
        {
            var fromKey = GetString(st, "key") ?? string.Empty;
            if (st["transitions"] is not JsonArray trs)
            {
                continue;
            }

            for (var i = 0; i < trs.Count; i++)
            {
                if (trs[i] is not JsonObject tr)
                {
                    continue;
                }

                var rawTarget = GetString(tr, "target") ?? "$self";
                var resolvedTarget = rawTarget == "$self" ? fromKey : rawTarget;
                if (FindState(resolvedTarget) is null)
                {
                    continue;
                }

                var pair = (fromKey, resolvedTarget);
                var idxInPair = pairSeen.GetValueOrDefault(pair);
                pairSeen[pair] = idxInPair + 1;
                var totalInPair = pairCounts[pair];

                var geom = ComputeEdgeGeometry(fromKey, resolvedTarget, idxInPair, totalInPair, i, trs.Count);
                var tKey = GetString(tr, "key") ?? $"t-{i + 1}";
                var tLabel = GetString(tr, "title") ?? tKey;
                var tTrigger = GetString(tr, "trigger") ?? "Manual";
                var taskCount = (tr["onExecute"] as JsonArray)?.Count ?? 0;

                list.Add(new CanvasEdge(MakeEdgeId(fromKey, i), fromKey, resolvedTarget, i, tKey, tLabel, tTrigger, taskCount, geom));
            }
        }

        return list;
    }

    private EdgeGeometry ComputeEdgeGeometry(string fromKey, string targetKey, int parallelIndex, int parallelTotal, int outIndex = 0, int outTotal = 1)
    {
        var fromPos = GetNodePos(fromKey);
        var fromWidth = fromKey == StartNodeKey ? StartNodeWidth : StateNodeWidth;
        var x1 = fromPos.X + fromWidth;
        var y1 = fromPos.Y + PortOffsetY;

        if (string.Equals(fromKey, targetKey, StringComparison.Ordinal))
        {
            var loopHeight = 56 + (parallelIndex * 24);
            var sx = fromPos.X + fromWidth - 36;
            var sy = fromPos.Y;
            var ex = fromPos.X + fromWidth;
            var ey = fromPos.Y + PortOffsetY;
            var path = FormattableString.Invariant($"M {sx:0.#} {sy:0.#} C {sx:0.#} {sy - loopHeight:0.#}, {ex + 54:0.#} {sy - loopHeight:0.#}, {ex:0.#} {ey:0.#}");
            return new EdgeGeometry(path, sx + 22, sy - (loopHeight * 0.72));
        }

        var toPos = GetNodePos(targetKey);
        var x2 = toPos.X;
        var y2 = toPos.Y + PortOffsetY;

        var spread = (parallelIndex - ((parallelTotal - 1) / 2.0)) * 38.0;
        var dx = Math.Max(90.0, Math.Abs(x2 - x1) * 0.45);
        var cx1 = x1 + dx;
        var cy1 = y1 + spread;
        var cx2 = x2 - dx;
        var cy2 = y2 + spread;

        var bezier = FormattableString.Invariant($"M {x1:0.#} {y1:0.#} C {cx1:0.#} {cy1:0.#}, {cx2:0.#} {cy2:0.#}, {x2:0.#} {y2:0.#}");
        var t = outTotal <= 1 ? 0.5 : 0.34 + ((outIndex / (double)(outTotal - 1)) * 0.32);
        var u = 1.0 - t;
        var midX = (u * u * u * x1) + (3 * u * u * t * cx1) + (3 * u * t * t * cx2) + (t * t * t * x2);
        var midY = (u * u * u * y1) + (3 * u * u * t * cy1) + (3 * u * t * t * cy2) + (t * t * t * y2);
        return new EdgeGeometry(bezier, midX, midY);
    }

    // --- Selection & Editing Helpers ---

    private JsonArray? GetHookArray(string nodeKey, string hook)
    {
        if (nodeKey == StartNodeKey)
        {
            return EnsureArray(EnsureObject(doc, "start"), "onExecute");
        }

        if (FindState(nodeKey) is { } stObj)
        {
            if (hook is "onEntry" or "onExit")
            {
                return EnsureArray(stObj, hook);
            }

            if (hook.StartsWith("transition:", StringComparison.Ordinal) &&
                int.TryParse(hook.AsSpan("transition:".Length), NumberStyles.Integer, CultureInfo.InvariantCulture, out var trIdx))
            {
                var trs = EnsureArray(stObj, "transitions");
                if (trIdx >= 0 && trIdx < trs.Count && trs[trIdx] is JsonObject trObj)
                {
                    return EnsureArray(trObj, "onExecute");
                }
            }
        }

        return null;
    }

    private JsonObject? GetSelectedTaskObject()
    {
        if (selectedTaskIndex < 0)
        {
            return null;
        }

        var arr = GetHookArray(selectedNodeKey, selectedTaskHook);
        if (arr is null || selectedTaskIndex >= arr.Count)
        {
            return null;
        }

        return arr[selectedTaskIndex] as JsonObject;
    }

    private JsonObject? GetSelectedTransitionObject()
    {
        if (selectedTransitionIndex < 0 || FindState(selectedNodeKey) is not { } stObj)
        {
            return null;
        }

        var trs = EnsureArray(stObj, "transitions");
        return selectedTransitionIndex < trs.Count ? trs[selectedTransitionIndex] as JsonObject : null;
    }

    private void MoveSelectedTask(int delta)
    {
        var arr = GetHookArray(selectedNodeKey, selectedTaskHook);
        if (arr is null)
        {
            return;
        }

        var newIdx = selectedTaskIndex + delta;
        if (newIdx < 0 || newIdx >= arr.Count)
        {
            return;
        }

        var item = arr[selectedTaskIndex]?.DeepClone();
        arr.RemoveAt(selectedTaskIndex);
        arr.Insert(newIdx, item);
        selectedTaskIndex = newIdx;
        SyncJsonFromDoc();
    }

    private void DeleteSelectedTask()
    {
        var arr = GetHookArray(selectedNodeKey, selectedTaskHook);
        if (arr is null || selectedTaskIndex < 0 || selectedTaskIndex >= arr.Count)
        {
            return;
        }

        arr.RemoveAt(selectedTaskIndex);
        selectedTaskIndex = -1;
        SyncJsonFromDoc();
    }

