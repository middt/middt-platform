    private IEnumerable<(string Category, List<WidgetPaletteItem> Items)> GetFilteredPaletteGroups()
    {
        var filter = paletteFilter.Trim();
        var items = string.IsNullOrEmpty(filter)
            ? PaletteItems
            : PaletteItems.Where(p =>
                p.Widget.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                p.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                p.Description.Contains(filter, StringComparison.OrdinalIgnoreCase));

        return items.GroupBy(p => p.Category).Select(g => (g.Key, g.ToList()));
    }

    private async Task LoadListAsync()
    {
        var response = await Client.ListAsync();
        if (response.IsSuccess)
        {
            layouts = response.Data ?? [];
        }
        else
        {
            Notification.Notify(NotificationSeverity.Error, "Yerleşimler yüklenemedi", response.ErrorText);
        }
    }

    private async Task OnSelectLayoutAsync(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            NewLayout(UiLayoutKind.View);
            return;
        }

        await OpenAsync(key);
    }

    private async Task OnSelectWorkflowSchemaAsync(string? wfKey)
    {
        await LoadWorkflowSchemaFieldsAsync(wfKey);
    }

    private async Task LoadWorkflowSchemaFieldsAsync(string? wfKey)
    {
        linkedWorkflowKey = NullIfWhiteSpace(wfKey);
        workflowFields.Clear();
        if (string.IsNullOrWhiteSpace(linkedWorkflowKey) || Services.GetService<WorkflowApiClient>() is not { } wfClient)
        {
            return;
        }

        var defResp = await wfClient.GetDefinitionJsonAsync(linkedWorkflowKey);
        if (!defResp.IsSuccess || defResp.Data is null)
        {
            return;
        }

        if (defResp.Data["dataSchema"] is JsonObject schemaObj && schemaObj["properties"] is JsonObject propsObj)
        {
            foreach (var (field, node) in propsObj)
            {
                if (node is JsonObject fSpec)
                {
                    var title = GetJsonString(fSpec, "title") ?? field;
                    var type = GetJsonString(fSpec, "type") ?? "string";
                    workflowFields.Add((field, title, type));
                }
            }
        }
    }

    private void GenerateSectionFromWorkflowSchema()
    {
        if (workflowFields.Count == 0)
        {
            return;
        }

        var items = new JsonArray();
        foreach (var f in workflowFields)
        {
            var row = new JsonObject
            {
                ["label"] = f.Title,
                ["value"] = $"{{{{ data.{f.Field} }}}}",
                ["visibleWhen"] = $"data.{f.Field} != null",
            };
            if (f.Type == "number")
            {
                row["format"] = "N2";
            }

            items.Add(row);
        }

        var sectionNode = new UiNode
        {
            Widget = "section",
            Props = new JsonObject
            {
                ["title"] = $"{linkedWorkflowKey} — Kayıt Bilgileri",
            },
            Children =
            [
                new UiNode
                {
                    Widget = "fields",
                    Props = new JsonObject
                    {
                        ["items"] = items,
                    },
                },
            ],
        };

        doc.Body.Add(sectionNode);
        selectedPath = $"{doc.Body.Count - 1}.0";
        SyncJsonFromDoc();
    }

    private void InsertWorkflowField((string Field, string Title, string Type) wfField)
    {
        var row = new JsonObject
        {
            ["label"] = wfField.Title,
            ["value"] = $"{{{{ data.{wfField.Field} }}}}",
            ["visibleWhen"] = $"data.{wfField.Field} != null",
        };
        if (wfField.Type == "number")
        {
            row["format"] = "N2";
        }

        if (selectedPath is not null && FindNodeByPath(selectedPath) is { Widget: "fields" } fieldsNode)
        {
            EnsureNodeArray(fieldsNode, "items").Add(row);
            SyncJsonFromDoc();
            return;
        }

        // Otherwise create a fields widget and append it
        var newFields = new UiNode
        {
            Widget = "fields",
            Props = new JsonObject
            {
                ["items"] = new JsonArray(row),
            },
        };
        doc.Body.Add(newFields);
        selectedPath = (doc.Body.Count - 1).ToString(CultureInfo.InvariantCulture);
        SyncJsonFromDoc();
    }

    private void NewLayout(string kind = UiLayoutKind.Page)
    {
        selectedKey = null;
        selectedPath = null;
        version = 0;
        doc = CreateDefaultDocument(kind);
        revisions = [];
        SyncJsonFromDoc();
        ResetMessages();
    }

    private async Task OpenAsync(string key)
    {
        var response = await Client.GetAsync(key);
        if (!response.IsSuccess || response.Data is null)
        {
            Notification.Notify(NotificationSeverity.Error, "Yüklenemedi", response.ErrorText);
            return;
        }

        selectedKey = key;
        selectedPath = null;
        version = response.Data.Version;
        doc = response.Data;
        SyncJsonFromDoc();
        ResetMessages();
        var history = await Client.RevisionsAsync(key);
        revisions = history.Data ?? [];
    }

    private void LoadRevision(UiLayoutRevisionModel revision)
    {
        try
        {
            var document = UiJson.Parse(revision.Content);
            document.Version = version;
            doc = document;
            selectedPath = null;
            SyncJsonFromDoc();
            ResetMessages();
