@namespace Middt.Framework.Blazor.Ui
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.Extensions.DependencyInjection
@using Middt.Framework.Model.Workflow
@using Middt.Framework.Expressions
@using Middt.Framework.Blazor.Ui.Components
@using Middt.Framework.Ui.Model
@using Middt.Framework.Ui.Rendering
@using Middt.Framework.Ui.Validation
@using Middt.Framework.Ui.Widgets

@* 2D Drag-and-Drop Visual Screen & Layout Studio (works standalone at /ui-admin and embedded inside WorkflowDesigner). *@
<div class="middt-wf-studio" data-testid="ui-layout-designer">
    <RadzenCard class="rz-p-3">
        <div class="middt-ui-toolbar" style="justify-content: space-between">
            <div class="middt-ui-toolbar">
                <label for="ui-layout-select" style="font-weight: 600; font-size: .88rem">Ekran / Yerleşim:</label>
                <select id="ui-layout-select" class="middt-wf-input" style="width: 240px"
                        value="@(selectedKey ?? "")" @onchange="@(e => OnSelectLayoutAsync(e.Value?.ToString()))">
                    @if (selectedKey is null)
                    {
                        <option value="">-- Yeni Yerleşim (@doc.Key) --</option>
                    }
                    @foreach (var item in layouts)
                    {
                        <option value="@item.Key">@(item.Title ?? item.Key) (@item.Key · @item.Kind · v@(item.Version))</option>
                    }
                </select>
                <RadzenButton Icon="add" Text="Yeni Sayfa" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => NewLayout(UiLayoutKind.Page))" />
                <RadzenButton Icon="view_quilt" Text="Yeni Akış Ekranı" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                              Click="@(() => NewLayout(UiLayoutKind.View))" />
                <span class="middt-ui-badge @(doc.Kind == UiLayoutKind.View ? "middt-ui-badge-primary" : "middt-ui-badge-info")">
                    @(doc.Kind == UiLayoutKind.View ? "view (Akış / Parça)" : "page (Tam Sayfa)")
                </span>
                @if (version > 0)
                {
                    <span class="middt-ui-badge middt-ui-badge-secondary">v@(version)</span>
                }
            </div>

            <div class="middt-ui-toolbar">
                @if (workflows.Count > 0)
                {
                    <label for="ui-wf-schema-select" style="font-size: .8rem; font-weight: 600">🔗 Akış Şeması:</label>
                    <select id="ui-wf-schema-select" class="middt-wf-input" style="width: 195px"
                            value="@(linkedWorkflowKey ?? "")"
                            @onchange="@(e => OnSelectWorkflowSchemaAsync(e.Value?.ToString()))">
                        <option value="">(İş akışı seçiniz)</option>
                        @foreach (var wf in workflows)
                        {
                            <option value="@wf.Key">@(wf.Title ?? wf.Key) (@wf.Key)</option>
                        }
                    </select>
                    @if (workflowFields.Count > 0)
                    {
                        <RadzenButton Icon="auto_fix_high" Text="Şemadan Alanları Ekle" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info"
                                      title="Seçili iş akışının dataSchema alanlarından otomatik Bölüm + Etiket/Değer tablosu oluşturur"
                                      Click="GenerateSectionFromWorkflowSchema" />
                    }
                }
            </div>

            <div class="middt-ui-toolbar">
                <RadzenButton Icon="data_object" Text="Biçimlendir" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Format" />
                <RadzenButton Icon="rule" Text="Doğrula" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="ValidateAsync" />
                <RadzenButton Icon="visibility" Text="Önizle" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="Preview" />
                <RadzenButton Icon="save" Text="Kaydet" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="SaveAsync" IsBusy="busy" />
                @if (selectedKey is not null)
                {
                    <RadzenButton Icon="delete" Text="Sil" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="DeleteAsync" Disabled="busy" />
                }
                @if (Embedded)
                {
                    <RadzenButton Icon="close" Text="Akışa Dön" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@(() => OnClose.InvokeAsync())" />
                }
            </div>
        </div>

        @if (errors.Count > 0)
        {
            <div class="middt-ui-alert middt-ui-alert-danger rz-mt-2" role="alert">
                <strong>@errors.Count hata</strong>
                <ul class="middt-ui-list">
                    @foreach (var e in errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }
        else if (validMessage is not null)
        {
            <div class="middt-ui-alert middt-ui-alert-success rz-mt-2" role="status">@validMessage</div>
        }
    </RadzenCard>

    <div class="middt-wf-studio-body">
        @* 1. Left Column: Palette of Draggable Widgets + Saved Layouts List *@
        <aside class="middt-wf-palette" aria-label="Ekran bileşen paleti ve yerleşimler">
            <div class="middt-wf-palette-group">
                <div class="middt-wf-palette-group-title">🧩 Bileşen Paleti (Sürükle & Bırak)</div>
                <input class="middt-wf-input" placeholder="Bileşen ara (section, fields, alert...)"
                       @bind="paletteFilter" @bind:event="oninput" />
                @foreach (var grp in GetFilteredPaletteGroups())
                {
                    <div class="middt-wf-palette-group-title">@grp.Category</div>
                    @foreach (var item in grp.Items)
                    {
                        <div class="middt-wf-palette-chip"
                             draggable="true"
                             title="@item.Description — Tuvale sürükleyin veya çift tıklayın"
                             @ondragstart="@(() => StartPaletteWidgetDrag(item.Widget))"
                             @ondblclick="@(() => QuickAddWidget(item.Widget))">
                            <span class="middt-wf-palette-chip-icon">@item.Icon</span>
                            <div class="middt-wf-palette-chip-text">
                                <strong>@item.Title</strong>
                                <small>@item.Widget</small>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (workflowFields.Count > 0)
            {
                <hr class="middt-ui-divider" />
                <div class="middt-wf-palette-group">
                    <div class="middt-wf-palette-group-title">🗂️ Akış Veri Alanları (@linkedWorkflowKey)</div>
                    <small class="middt-ui-text-muted">Tıklayarak seçili <code>fields</code> bileşenine veya tuvale ekleyin:</small>
                    @foreach (var wfField in workflowFields)
                    {
                        <button type="button" class="middt-wf-task-pill"
                                title="Tıklayarak '{{ data.@wfField.Field }}' alanını ekle"
                                @onclick="@(() => InsertWorkflowField(wfField))">
                            <span>➕ @wfField.Title</span>
                            <small><code>data.@wfField.Field</code></small>
                        </button>
                    }
                </div>
            }

            <hr class="middt-ui-divider" />
            <details open="@(!Embedded)">
                <summary style="font-weight: 700; font-size: .78rem; cursor: pointer">📂 Kayıtlı Yerleşimler (@layouts.Count)</summary>
                <ul class="middt-ui-admin-items" aria-label="Yerleşimler">
                    @foreach (var item in layouts)
                    {
                        <li>
                            <button type="button"
                                    class="@(item.Key == selectedKey ? "middt-ui-admin-item middt-ui-admin-item-active" : "middt-ui-admin-item")"
                                    aria-current="@(item.Key == selectedKey ? "true" : null)"
                                    @onclick="@(() => OpenAsync(item.Key))">
                                <span>@(item.Title ?? item.Key)</span>
                                <small>@item.Key · @item.Kind · v@(item.Version)</small>
                            </button>
                        </li>
                    }
                </ul>
            </details>
        </aside>

        @* 2. Center Column: Visual Drag-and-Drop Screen Tree + Live Preview + JSON Code *@
        <div style="display: flex; flex-direction: column; gap: .75rem; min-width: 0">
            <div class="middt-ui-studio-canvas"
                 @ondragover:preventDefault="true"
                 @ondrop="@(() => OnDropIntoContainer(string.Empty))">
                <div class="middt-ui-toolbar" style="justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: .5rem">
                    <div style="display: flex; align-items: center; gap: .5rem; cursor: pointer" @onclick="@(() => SelectNode(null))">
                        <span class="middt-ui-badge middt-ui-badge-info">🖥️ Ekran Gövdesi (body)</span>
                        <strong>@(doc.Title ?? doc.Key)</strong>
                        <code class="middt-ui-text-code">(@doc.Key)</code>
                    </div>
                    <div class="middt-ui-toolbar">
                        <RadzenButton Icon="settings" Text="Ekran Ayarları" Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="@(selectedPath is null ? ButtonStyle.Primary : ButtonStyle.Light)"
                                      Click="@(() => SelectNode(null))" />
                    </div>
                </div>

                @if (doc.Body.Count == 0)
                {
                    <div class="middt-wf-dropzone" style="padding: 2rem; text-align: center">
                        <div class="middt-wf-dropzone-empty" style="font-size: .88rem">
                            Sol paletten bir bileşeni (ör. <strong>Kart / Bölüm</strong>, <strong>Yan Yana Sütunlar</strong>, <strong>Etiket / Değer Tablosu</strong>) buraya sürükleyip bırakın veya çift tıklayın.
                        </div>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < doc.Body.Count; i++)
                    {
                        var idx = i;
                        var path = idx.ToString(CultureInfo.InvariantCulture);
                        @RenderWidgetNodeCard(doc.Body[idx], path, doc.Body, idx)
                    }
                }
            </div>

            @if (preview is not null && previewContext is not null)
            {
                <RadzenCard>
                    <div class="middt-ui-toolbar" style="justify-content: space-between; margin-bottom: .5rem">
                        <h2 class="middt-ui-section-title">👁️ Canlı Önizleme</h2>
                        <RadzenButton Icon="close" Text="Önizlemeyi Gizle" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                      Click="@(() => preview = null)" />
                    </div>
                    <UiLayoutView @key="previewKey" Layout="preview" Context="previewContext" />
                </RadzenCard>
            }

            <RadzenCard>
                <div class="middt-ui-toolbar" style="justify-content: space-between; margin-bottom: .4rem">
                    <label for="ui-layout-json" style="font-weight: 600; font-size: .85rem">
                        { } Yerleşim JSON Kodu (Görsel tuval ile çift yönlü senkronize)
                    </label>
                    @if (revisions.Count > 0)
                    {
                        <details>
                            <summary style="font-size: .8rem; cursor: pointer">Önceki sürümler (@revisions.Count)</summary>
                            <ul class="middt-ui-list">
                                @foreach (var revision in revisions)
                                {
                                    <li>
                                        v@(revision.Version) · @revision.CreatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) · @revision.CreatedBy
                                        <RadzenButton Text="Editöre yükle" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => LoadRevision(revision))" />
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
                <textarea id="ui-layout-json" class="middt-ui-editor rz-textarea" style="min-height: 200px" spellcheck="false"
                          value="@json" @onchange="OnRawJsonInput"></textarea>
            </RadzenCard>
        </div>

        @* 3. Right Column: Context-Sensitive Property Inspector *@
        <aside class="middt-wf-inspector" aria-label="Seçili bileşen veya ekran özellikleri">
            @RenderInspector()
        </aside>
    </div>
</div>

@code {
    private sealed record WidgetPaletteItem(string Category, string Widget, string Icon, string Title, string Description);

    private static readonly WidgetPaletteItem[] PaletteItems =
    [
        new("📦 Düzen & Kapsayıcılar", "section", "🗂️", "Kart / Bölüm (section)", "Başlıklı kart kapsayıcısı; içine diğer bileşenler sürüklenir."),
        new("📦 Düzen & Kapsayıcılar", "columns", "🏛️", "Yan Yana Sütunlar (columns)", "Alt bileşenlerini yan yana sütunlar halinde gösterir."),
        new("📦 Düzen & Kapsayıcılar", "list", "🔁", "Tekrarlayan Liste (list)", "Bir dizi (data.items) içindeki her kayıt için alt bileşenleri tekrarlar."),
        new("📦 Düzen & Kapsayıcılar", "record", "🔍", "Kayıt Yükleyici (record)", "Tekil bir varlık kaydını (entity/recordId) yükler."),
        new("📦 Düzen & Kapsayıcılar", "layout", "🧩", "Alt Ekran Gömme (layout)", "Başka bir 'view' ekranını bu ekranın içine gömer."),
        new("📝 İçerik & Göstergeler", "fields", "📋", "Etiket / Değer Tablosu (fields)", "Müşteri adı, tutar, durum gibi etiket-değer alanlarını listeler."),
        new("📝 İçerik & Göstergeler", "heading", "🔤", "Başlık (heading)", "H1–H6 seviyesinde dinamik başlık metni."),
        new("📝 İçerik & Göstergeler", "text", "📄", "Metin / Paragraf (text)", "Açıklama, kod veya bilgi paragrafı."),
        new("📝 İçerik & Göstergeler", "alert", "⚠️", "Uyarı Kutusu (alert)", "Bilgi, başarı, uyarı veya hata mesaj kutusu."),
        new("📝 İçerik & Göstergeler", "badge", "🏷️", "Durum Rozeti (badge)", "Renkli durum etiketi (Onaylandı, Bekliyor vb.)."),
        new("📝 İçerik & Göstergeler", "divider", "➖", "Ayırıcı Çizgi (divider)", "Bölümler arası yatay çizgi."),
        new("📝 İçerik & Göstergeler", "link", "🔗", "Bağlantı / Buton (link)", "Sayfa içi veya harici yönlendirme bağlantısı."),
        new("📊 Veri Tablosu", "grid", "📊", "Veri Tablosu (grid)", "Sunucu sayfalı, arama filtreli ve CRUD destekli tablo."),
    ];

    private List<UiLayoutSummary> layouts = [];
    private List<UiWidgetSpecModel> widgets = [];
    private List<UiLayoutRevisionModel> revisions = [];
    private List<WorkflowSummaryModel> workflows = [];
    private List<(string Field, string Title, string Type)> workflowFields = [];
    private List<string> errors = [];

    private UiLayoutDocument doc = CreateDefaultDocument(UiLayoutKind.Page);
    private string? selectedKey;
    private string? selectedPath;
    private string? linkedWorkflowKey;
    private string paletteFilter = string.Empty;
    private string? dragWidgetType;
    private string? dragSourcePath;
    private int version;
    private string json = string.Empty;
    private string? validMessage;
    private bool busy;
    private UiLayoutDocument? preview;
    private UiRenderContext? previewContext;
    private int previewKey;

    [Inject]
    private UiApiClient Client { get; set; } = default!;

    [Inject]
    private UiWidgetCatalog Catalog { get; set; } = default!;

    [Inject]
    private NotificationService Notification { get; set; } = default!;

    [Inject]
    private DialogService DialogService { get; set; } = default!;

    [Inject]
    private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    /// <summary>Raised after a save or delete (e.g. to refresh the menu).</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Raised with the saved layout's key when a layout is saved.</summary>
    [Parameter]
    public EventCallback<string> OnSavedKey { get; set; }

    /// <summary>Raised when the user clicks "Akışa Dön" in embedded mode.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>True when rendered inside a modal/drawer in WorkflowDesigner.</summary>
    [Parameter]
    public bool Embedded { get; set; }

    /// <summary>Optional layout key to open or initialize on startup.</summary>
    [Parameter]
    public string? InitialKey { get; set; }

    /// <summary>Optional workflow key whose dataSchema should be preloaded for field binding.</summary>
    [Parameter]
    public string? InitialWorkflowKey { get; set; }

    /// <summary>Optional pre-built document when creating a brand new workflow state screen.</summary>
    [Parameter]
    public UiLayoutDocument? InitialDocument { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SyncJsonFromDoc();
        await LoadListAsync();
        var response = await Client.WidgetsAsync();
        widgets = response.Data ?? [];

        if (Services.GetService<WorkflowApiClient>() is { } wfClient)
        {
            var wfResp = await wfClient.ListWorkflowsAsync();
            if (wfResp.IsSuccess && wfResp.Data is not null)
            {
                workflows = wfResp.Data;
            }
        }

        // Check query string if not provided via parameters
        var targetKey = InitialKey;
        var targetWf = InitialWorkflowKey;
        if (!Embedded)
        {
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            targetKey ??= query["key"];
            targetWf ??= query["workflow"];
        }

        if (!string.IsNullOrWhiteSpace(targetWf))
        {
            await LoadWorkflowSchemaFieldsAsync(targetWf);
        }

        if (InitialDocument is not null)
        {
            selectedKey = layouts.Any(l => string.Equals(l.Key, InitialDocument.Key, StringComparison.Ordinal))
                ? InitialDocument.Key
                : null;
            version = InitialDocument.Version;
            doc = UiJson.Parse(UiJson.Serialize(InitialDocument));
            selectedPath = null;
            SyncJsonFromDoc();
        }
        else if (!string.IsNullOrWhiteSpace(targetKey))
        {
            if (layouts.Any(l => string.Equals(l.Key, targetKey, StringComparison.Ordinal)))
            {
                await OpenAsync(targetKey);
            }
            else
            {
                selectedKey = null;
                version = 0;
                doc = CreateDefaultDocument(UiLayoutKind.View, targetKey);
                if (workflowFields.Count > 0)
                {
                    GenerateSectionFromWorkflowSchema();
                }
                else
                {
                    SyncJsonFromDoc();
                }
            }
        }
    }

    private RenderFragment RenderWidgetNodeCard(UiNode node, string path, List<UiNode> parentList, int indexInParent) => __builder =>
    {
        var isSelected = string.Equals(selectedPath, path, StringComparison.Ordinal);
        var isContainer = IsContainerWidget(node.Widget);

        <div class="@(isSelected ? "middt-ui-widget-card middt-ui-widget-card-selected" : "middt-ui-widget-card")"
             draggable="true"
             @onclick:stopPropagation="true"
             @onclick="@(() => SelectNode(path))"
             @ondragstart:stopPropagation="true"
             @ondragstart="@(() => StartExistingNodeDrag(path))">
            <div class="middt-ui-toolbar" style="justify-content: space-between">
                <div style="display: flex; align-items: center; gap: .45rem; min-width: 0">
                    <span>@GetWidgetIcon(node.Widget)</span>
                    <span class="middt-ui-badge middt-ui-badge-primary" style="font-size: .72rem">@node.Widget</span>
                    <strong style="font-size: .86rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
                        @GetWidgetSummary(node)
                    </strong>
                    @if (!string.IsNullOrWhiteSpace(node.VisibleWhen))
                    {
                        <span class="middt-ui-badge middt-ui-badge-warning" style="font-size: .68rem" title="Görünürlük koşulu (visibleWhen)">
                            👁️ @node.VisibleWhen
                        </span>
                    }
                </div>
                <div class="middt-ui-toolbar" @onclick:stopPropagation="true">
                    @if (node.Widget == "layout" && node.StringProp("key") is { Length: > 0 } subLayoutKey)
                    {
                        <RadzenButton Icon="open_in_new" Text="@subLayoutKey" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Info"
                                      title="Gömülü alt ekranı aç"
                                      Click="@(() => OpenAsync(subLayoutKey))" />
                    }
                    <RadzenButton Icon="arrow_upward" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(indexInParent <= 0)"
                                  Click="@(() => MoveNodeInList(parentList, indexInParent, -1))" />
                    <RadzenButton Icon="arrow_downward" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(indexInParent >= parentList.Count - 1)"
                                  Click="@(() => MoveNodeInList(parentList, indexInParent, 1))" />
                    <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                  title="Bileşeni çoğalt"
                                  Click="@(() => DuplicateNodeInList(parentList, indexInParent))" />
                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                                  title="Bileşeni sil"
                                  Click="@(() => DeleteNodeFromList(parentList, indexInParent))" />
                </div>
            </div>

            @if (node.Widget == "fields" && node.ArrayProp("items") is { Count: > 0 } fieldItems)
            {
                <div style="display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .15rem">
                    @foreach (var fItem in fieldItems.OfType<JsonObject>())
                    {
                        <span class="middt-wf-edge-pill" style="width: auto; font-size: .73rem; padding: .15rem .45rem">
                            <strong>@(GetJsonString(fItem, "label") ?? "Alan"):</strong>
                            <code>@(GetJsonString(fItem, "value") ?? "")</code>
                        </span>
                    }
                </div>
            }

            @if (isContainer)
            {
                var children = node.Children ??= [];
                <div class="middt-ui-widget-children"
                     @ondragover:preventDefault="true"
                     @ondragover:stopPropagation="true"
                     @ondrop:stopPropagation="true"
                     @ondrop="@(() => OnDropIntoContainer(path))">
                    <div class="middt-ui-toolbar" style="justify-content: space-between">
                        <small class="middt-ui-text-muted">
                            Alt Bileşenler (@children.Count) — Paletten buraya bileşen sürükleyin
                        </small>
                        <select class="middt-wf-input" style="width: 170px; padding: .15rem .35rem; font-size: .75rem"
                                value=""
                                @onchange="@(e => { AddChildWidget(node, path, e.Value?.ToString()); })">
                            <option value="">+ Alt Bileşen Ekle...</option>
                            @foreach (var p in PaletteItems)
                            {
                                <option value="@p.Widget">@p.Icon @p.Title</option>
                            }
                        </select>
                    </div>

                    @if (children.Count > 0)
                    {
                        <div class="@(node.Widget == "columns" ? "middt-ui-widget-columns-grid" : "middt-ui-form")">
                            @for (var ci = 0; ci < children.Count; ci++)
                            {
                                var childIdx = ci;
                                var childPath = $"{path}.{childIdx}";
                                @RenderWidgetNodeCard(children[childIdx], childPath, children, childIdx)
                            }
                        </div>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment RenderInspector() => __builder =>
    {
        if (selectedPath is not null && FindNodeByPath(selectedPath) is { } node)
        {
            var props = node.Props ??= new JsonObject();
            <div class="middt-ui-form">
                <div class="middt-ui-toolbar" style="justify-content: space-between">
                    <div>
                        <span class="middt-ui-badge middt-ui-badge-primary">🧩 Bileşen (@node.Widget)</span>
                        <h3 class="middt-ui-section-title rz-mt-1">@GetWidgetTitle(node.Widget)</h3>
                    </div>
                    <RadzenButton Icon="arrow_back" Text="Ekran Ayarları" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => SelectNode(null))" />
                </div>

                <div class="middt-wf-grid-2">
                    <div class="middt-ui-input">
                        <label>Bileşen Tipi (widget)</label>
                        <select class="middt-wf-input" value="@node.Widget"
                                @onchange="@(e => ChangeWidgetType(node, e.Value?.ToString()))">
                            @foreach (var p in PaletteItems)
                            {
                                <option value="@p.Widget">@p.Icon @p.Title</option>
                            }
                        </select>
                    </div>
                    <div class="middt-ui-input">
