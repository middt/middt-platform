    private void SetLayoutKind(string? kind)
    {
        doc.Kind = kind == UiLayoutKind.View ? UiLayoutKind.View : UiLayoutKind.Page;
        if (doc.Kind == UiLayoutKind.View)
        {
            doc.Menu = null;
        }
        else
        {
            doc.Menu ??= new UiMenu { Title = doc.Title ?? doc.Key, Icon = "dashboard", Order = 100 };
        }

        SyncJsonFromDoc();
    }

    private void SetLayoutRoles(string? csv)
    {
        doc.Roles = (csv ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .ToList();
        SyncJsonFromDoc();
    }

    private void SetNodeString(UiNode node, string prop, string? value)
    {
        var p = node.Props ??= new JsonObject();
        if (string.IsNullOrWhiteSpace(value))
        {
            p.Remove(prop);
        }
        else
        {
            p[prop] = value;
        }

        SyncJsonFromDoc();
    }

    private void SetNodeInt(UiNode node, string prop, string? raw, int fallback)
    {
        var p = node.Props ??= new JsonObject();
        p[prop] = int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var v) ? v : fallback;
        SyncJsonFromDoc();
    }

    private static string GetNodeCsvArray(UiNode node, string prop) =>
        node.ArrayProp(prop) is { } arr
            ? string.Join(", ", arr.Select(x => x?.ToString()).Where(s => !string.IsNullOrWhiteSpace(s)))
            : string.Empty;

    private void SetNodeCsvArray(UiNode node, string prop, string? csv)
    {
        var p = node.Props ??= new JsonObject();
        var items = (csv ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .ToArray();
        if (items.Length == 0)
        {
            p.Remove(prop);
        }
        else
        {
            p[prop] = new JsonArray(items.Select(s => (JsonNode)JsonValue.Create(s)!).ToArray());
        }

        SyncJsonFromDoc();
    }

    private static JsonArray EnsureNodeArray(UiNode node, string prop)
    {
        var p = node.Props ??= new JsonObject();
        if (p[prop] is JsonArray arr)
        {
            return arr;
        }

        var created = new JsonArray();
        p[prop] = created;
        return created;
    }

