    private void OnDropIntoContainer(string containerPath)
    {
        var targetList = string.IsNullOrEmpty(containerPath)
            ? doc.Body
            : (FindNodeByPath(containerPath) is { } container && IsContainerWidget(container.Widget)
                ? (container.Children ??= [])
                : doc.Body);

        if (!string.IsNullOrEmpty(dragWidgetType))
        {
            var created = CreateWidgetNode(dragWidgetType);
            targetList.Add(created);
            var newIdx = targetList.Count - 1;
            selectedPath = string.IsNullOrEmpty(containerPath)
                ? newIdx.ToString(CultureInfo.InvariantCulture)
                : $"{containerPath}.{newIdx}";
            SyncJsonFromDoc();
        }
        else if (!string.IsNullOrEmpty(dragSourcePath) &&
                 !string.Equals(dragSourcePath, containerPath, StringComparison.Ordinal) &&
                 !containerPath.StartsWith(dragSourcePath + ".", StringComparison.Ordinal))
        {
            if (RemoveNodeAtPath(dragSourcePath) is { } moved)
            {
                targetList.Add(moved);
                selectedPath = null;
                SyncJsonFromDoc();
            }
        }

        dragWidgetType = null;
        dragSourcePath = null;
    }

    private void QuickAddWidget(string widget)
    {
        if (selectedPath is not null && FindNodeByPath(selectedPath) is { } sel && IsContainerWidget(sel.Widget))
        {
            var children = sel.Children ??= [];
            children.Add(CreateWidgetNode(widget));
            selectedPath = $"{selectedPath}.{children.Count - 1}";
            SyncJsonFromDoc();
            return;
        }

        doc.Body.Add(CreateWidgetNode(widget));
        selectedPath = (doc.Body.Count - 1).ToString(CultureInfo.InvariantCulture);
        SyncJsonFromDoc();
    }

    private void AddChildWidget(UiNode container, string containerPath, string? widget)
    {
        if (string.IsNullOrWhiteSpace(widget))
        {
            return;
        }

        var children = container.Children ??= [];
        children.Add(CreateWidgetNode(widget));
        selectedPath = $"{containerPath}.{children.Count - 1}";
        SyncJsonFromDoc();
    }

    private void MoveNodeInList(List<UiNode> list, int index, int delta)
    {
        var next = index + delta;
        if (next < 0 || next >= list.Count)
        {
            return;
        }

        (list[index], list[next]) = (list[next], list[index]);
        SyncJsonFromDoc();
    }

    private void DuplicateNodeInList(List<UiNode> list, int index)
    {
        if (index < 0 || index >= list.Count)
        {
            return;
        }

        var jsonClone = JsonSerializer.Serialize(list[index], UiJson.Options);
        if (JsonSerializer.Deserialize<UiNode>(jsonClone, UiJson.Options) is { } copy)
        {
            list.Insert(index + 1, copy);
            SyncJsonFromDoc();
        }
    }

    private void DeleteNodeFromList(List<UiNode> list, int index)
    {
        if (index < 0 || index >= list.Count)
        {
            return;
        }

        list.RemoveAt(index);
        selectedPath = null;
        SyncJsonFromDoc();
    }

    private UiNode? FindNodeByPath(string path)
    {
        var parts = path.Split('.', StringSplitOptions.RemoveEmptyEntries);
        List<UiNode>? currentList = doc.Body;
        UiNode? current = null;

        foreach (var part in parts)
        {
            if (currentList is null || !int.TryParse(part, NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx) || idx < 0 || idx >= currentList.Count)
            {
                return null;
            }

            current = currentList[idx];
            currentList = current.Children;
        }

        return current;
    }

    private UiNode? RemoveNodeAtPath(string path)
    {
        var parts = path.Split('.', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return null;
        }

        List<UiNode>? parentList = doc.Body;
        for (var i = 0; i < parts.Length - 1; i++)
        {
            if (parentList is null || !int.TryParse(parts[i], NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx) || idx < 0 || idx >= parentList.Count)
            {
                return null;
            }

            parentList = parentList[idx].Children;
        }

        if (parentList is null || !int.TryParse(parts[^1], NumberStyles.Integer, CultureInfo.InvariantCulture, out var lastIdx) || lastIdx < 0 || lastIdx >= parentList.Count)
        {
            return null;
        }

        var removed = parentList[lastIdx];
        parentList.RemoveAt(lastIdx);
        return removed;
    }

    private void ChangeWidgetType(UiNode node, string? newWidget)
    {
        if (string.IsNullOrWhiteSpace(newWidget))
        {
            return;
        }

        var template = CreateWidgetNode(newWidget);
        node.Widget = template.Widget;
        node.Props = template.Props;
        node.Children = template.Children;
        SyncJsonFromDoc();
    }

