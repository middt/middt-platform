    private void MoveJsonArrayItem(JsonArray arr, int index, int delta)
    {
        var next = index + delta;
        if (next < 0 || next >= arr.Count)
        {
            return;
        }

        var item = arr[index]?.DeepClone();
        arr.RemoveAt(index);
        arr.Insert(next, item);
        SyncJsonFromDoc();
    }

    private void ReplaceNodePropsFromJson(UiNode node, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            node.Props = new JsonObject();
            SyncJsonFromDoc();
            return;
        }

        try
        {
            if (JsonNode.Parse(raw) is JsonObject parsed)
            {
                node.Props = parsed;
                SyncJsonFromDoc();
            }
        }
        catch (JsonException)
        {
            // Keep existing props when invalid
        }
    }

    private static string? GetJsonString(JsonObject obj, string prop) =>
        obj[prop] is JsonValue val && val.TryGetValue<string>(out var s) ? s : null;

    private static void SetJsonString(JsonObject obj, string prop, string? val)
    {
        if (string.IsNullOrWhiteSpace(val))
        {
            obj.Remove(prop);
        }
        else
        {
            obj[prop] = val;
        }
    }

