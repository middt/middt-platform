    private UiLayoutDocument? TryParse()
    {
        ResetMessages();
        try
        {
            return UiJson.Parse(json);
        }
        catch (JsonException ex)
        {
            errors = [$"Geçersiz JSON: {ex.Message}"];
            return null;
        }
    }

    private async Task ValidateAsync()
    {
        if (TryParse() is not { } document)
        {
            return;
        }

        doc = document;
        var response = await Client.ValidateAsync(document);
        if (!response.IsSuccess)
        {
            errors = [.. response.MessageList];
            return;
        }

        errors = response.Data?.Errors ?? [];
        validMessage = errors.Count == 0 ? "✔ Ekran yerleşimi ve tüm ifadeler geçerli." : null;
    }

    private async Task Preview()
    {
        if (TryParse() is not { } document)
        {
            return;
        }

        doc = document;
        var validation = new UiLayoutValidator(Catalog).Validate(document);
        errors = validation.Errors;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var sampleData = new JsonObject
        {
            ["title"] = "Örnek Kayıt Başlığı",
            ["customerName"] = "Anadolu Lojistik A.Ş.",
            ["customerKey"] = "CUST-2026-001",
            ["amount"] = 250000,
            ["termMonths"] = 24,
            ["status"] = "Active",
        };
        foreach (var wfField in workflowFields)
        {
            if (!sampleData.ContainsKey(wfField.Field))
            {
                sampleData[wfField.Field] = wfField.Type is "number" or "integer" ? 1000 : $"Örnek {wfField.Title}";
            }
        }

        var vars = new Dictionary<string, JsonNode?>
        {
            [UiExpressions.Query] = new JsonObject(),
            ["data"] = sampleData,
            ["instance"] = new JsonObject
            {
                ["key"] = "WF-PREVIEW-01",
                ["state"] = "review",
                ["status"] = "Active",
            },
        };

        preview = document;
        previewContext = new UiRenderContext(Catalog, ExpressionUser.FromPrincipal(state.User), vars, interactive: true)
        {
            IdPrefix = "ui-preview",
        };
        previewKey++;
    }

    private async Task SaveAsync()
    {
        if (TryParse() is not { } document)
        {
            return;
        }

        if (selectedKey is not null && document.Key != selectedKey)
        {
            errors = ["Kayıtlı bir yerleşimin anahtarı değiştirilemez; yeni yerleşim için 'Yeni' kullanın."];
            return;
        }

        document.Version = version;
        busy = true;
        try
        {
            var response = await Client.SaveAsync(document);
            if (!response.IsSuccess || response.Data is null)
            {
                errors = [.. response.MessageList];
                return;
            }

            selectedKey = response.Data.Key;
            version = response.Data.Version;
            doc = response.Data;
            SyncJsonFromDoc();
            validMessage = $"✔ '{selectedKey}' ekran yerleşimi kaydedildi (v{version}).";
            Notification.Notify(NotificationSeverity.Success, "Kaydedildi", $"'{selectedKey}' ekranı güncellendi.");
            await LoadListAsync();
            revisions = (await Client.RevisionsAsync(selectedKey)).Data ?? [];
            await OnSavedKey.InvokeAsync(selectedKey);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (selectedKey is null
            || await DialogService.Confirm($"'{selectedKey}' silinsin mi?", "Sil", new ConfirmOptions { OkButtonText = "Sil", CancelButtonText = "Vazgeç" }) != true)
        {
            return;
        }

        var response = await Client.DeleteAsync(selectedKey, version);
        if (!response.IsSuccess)
        {
            errors = [.. response.MessageList];
            return;
        }

        Notification.Notify(NotificationSeverity.Success, "Silindi", selectedKey);
        NewLayout(UiLayoutKind.Page);
        await LoadListAsync();
        await OnChanged.InvokeAsync();
    }

