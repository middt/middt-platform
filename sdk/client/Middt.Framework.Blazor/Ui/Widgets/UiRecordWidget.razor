@namespace Middt.Framework.Blazor.Ui.Widgets
@using System.Text.Json.Nodes
@using Middt.Framework.Blazor.Ui.Components
@using Middt.Framework.Ui.Rendering
@inherits UiWidgetBase
@implements IDisposable

@if (loading)
{
    <p class="middt-ui-text middt-ui-text-muted" role="status">Yükleniyor...</p>
}
else if (record is null)
{
    <div class="middt-ui-alert middt-ui-alert-warning" role="alert">@(error ?? Node.StringProp("notFound") ?? "Kayıt bulunamadı.")</div>
}
else
{
    <UiNodeList Nodes="Node.Children" Context="@RecordContext(record)" />
}

@code {
    private readonly CancellationTokenSource cancellation = new();
    private CancellationTokenSource? requestCancellation;
    private JsonObject? record;
    private (string Entity, string Id)? loadedKey;
    private int requestVersion;
    private string? error;
    private bool loading = true;
    private (UiRenderContext Parent, JsonObject Record, UiRenderContext Context)? recordContext;

    [Inject]
    private UiDataClient DataClient { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        var entity = Node.StringProp("entity") ?? string.Empty;
        var id = Text("recordId");
        var key = (entity, id);
        if (loadedKey == key)
        {
            return;
        }

        loadedKey = key;
        var currentRequest = ++requestVersion;
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
        requestCancellation = null;

        record = null;
        error = null;
        if (string.IsNullOrWhiteSpace(id))
        {
            loading = false;
            return;
        }

        var linkedCts = CancellationTokenSource.CreateLinkedTokenSource(cancellation.Token);
        requestCancellation = linkedCts;
        loading = true;
        try
        {
            var response = await DataClient.GetByIdAsync(entity, id, linkedCts.Token);
            if (currentRequest == requestVersion)
            {
                record = response.IsSuccess ? response.Data : null;
                error = response.IsSuccess ? null : response.ErrorText;
            }
        }
        catch (OperationCanceledException) when (linkedCts.IsCancellationRequested)
        {
        }
        finally
        {
            if (currentRequest == requestVersion)
            {
                loading = false;
            }
        }
    }

    /// <summary>Same child context while the context and the record are unchanged, so the children are not re-rendered.</summary>
    private UiRenderContext RecordContext(JsonObject value)
    {
        if (recordContext is not { } cached || !ReferenceEquals(cached.Parent, Context) || !ReferenceEquals(cached.Record, value))
        {
            recordContext = cached = (Context, value, Context.With(UiExpressions.Record, value));
        }

        return cached.Context;
    }

    public void Dispose()
    {
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
