<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Product>Middt Framework Agents</Product>
    <Description>Microsoft Agent Framework (Microsoft.Agents.AI + Microsoft.Extensions.AI) integration for Middt workflows: single and multi-agent orchestration, structured outputs, tool calling, and OpenTelemetry tracing.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Middt.Framework.Common\Middt.Framework.Common.csproj" />
    <ProjectReference Include="..\Middt.Framework.Workflow\Middt.Framework.Workflow.csproj" />
  </ItemGroup>

</Project>
