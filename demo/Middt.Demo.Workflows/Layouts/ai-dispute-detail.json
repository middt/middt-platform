{
  "$schema": "../../../spec/ui-layout.schema.json",
  "key": "ai-dispute-detail",
  "title": "AI İtiraz ve Fraud İnceleme Detayı",
  "kind": "view",
  "version": 4,
  "body": [
    {
      "widget": "columns",
      "widths": ["1", "1", "1"],
      "children": [
        {
          "widget": "stat",
          "label": "İtiraz Tutarı (₺)",
          "value": "{{ data.amount }}",
          "format": "N2",
          "icon": "payments",
          "color": "info",
          "subtitle": "İtiraz No: {{ data.disputeNo }}"
        },
        {
          "widget": "stat",
          "label": "AI Risk Seviyesi",
          "value": "{{ instance.agents.disputeOrchestrator.riskLevel ?? \"Değerlendiriliyor\" }}",
          "icon": "shield",
          "color": "warning",
          "subtitle": "Skor: {{ instance.agents.disputeOrchestrator.riskScore ?? 0 }} / 100"
        },
        {
          "widget": "stat",
          "label": "Önerilen İade (₺)",
          "value": "{{ instance.agents.disputeOrchestrator.recommendedRefund ?? 0 }}",
          "format": "N2",
          "icon": "price_check",
          "color": "success",
          "subtitle": "Politika: {{ instance.agents.disputeOrchestrator.policyCode ?? \"-\" }}"
        }
      ]
    },
    {
      "widget": "alert",
      "severity": "info",
      "text": "AI Orkestratör (dispute-orchestrator) araçları ve MCP sunucusunu çalıştırarak bu dosyayı Uzman İncelemesine yönlendirdi.",
      "visibleWhen": "instance.state == \"specialist-review\""
    },
    {
      "widget": "alert",
      "severity": "danger",
      "text": "Yüksek risk / yetkisiz işlem şüphesi! AI Orkestratör bu dosyayı doğrudan Fraud ve Güvenlik İncelemesine yönlendirdi.",
      "visibleWhen": "instance.state == \"fraud-investigation\""
    },
    {
      "widget": "section",
      "title": "İtiraz ve İşlem Bilgileri",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "İtiraz No", "value": "{{ data.disputeNo }}" },
            { "label": "Müşteri Adı", "value": "{{ data.customerName }}" },
            { "label": "Üye İşyeri", "value": "{{ data.merchantName }}" },
            { "label": "İşlem Referansı", "value": "{{ data.transactionRef }}" },
            { "label": "İtiraz Tutarı", "value": "{{ data.amount }}", "format": "N2" },
            { "label": "Kategori", "value": "{{ data.category }}" },
            { "label": "Müşteri Beyanı", "value": "{{ data.reason }}", "visibleWhen": "data.reason != null" }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "AI Orkestratör Kararı ve Akış Yönlendirmesi",
      "visibleWhen": "instance.agents != null && instance.agents.disputeOrchestrator != null",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "AI Kararı", "value": "{{ instance.agents.disputeOrchestrator.decision }}" },
            { "label": "Seçilen Akış Geçişi", "value": "{{ instance.agents.disputeOrchestrator.selectedTransition }}" },
            { "label": "Risk Seviyesi", "value": "{{ instance.agents.disputeOrchestrator.riskLevel }}" },
            { "label": "Risk Skoru", "value": "{{ instance.agents.disputeOrchestrator.riskScore }} / 100" },
            { "label": "Önerilen İade Tutarı", "value": "{{ instance.agents.disputeOrchestrator.recommendedRefund }}", "format": "N2" },
            { "label": "Uygulanan Politika Kodu", "value": "{{ instance.agents.disputeOrchestrator.policyCode }}" },
            { "label": "İşyeri Mutabakat Durumu", "value": "{{ instance.agents.disputeOrchestrator.settlementStatus }}", "visibleWhen": "instance.agents.disputeOrchestrator.settlementStatus != null" },
            { "label": "Hız (Velocity) Skoru", "value": "{{ instance.agents.disputeOrchestrator.velocityScore }}", "visibleWhen": "instance.agents.disputeOrchestrator.velocityScore != null" },
            { "label": "Analiz Özeti", "value": "{{ instance.agents.disputeOrchestrator.summary }}" },
            { "label": "Önerilen Aksiyon", "value": "{{ instance.agents.disputeOrchestrator.recommendation }}" },
            { "label": "Orkestratör Ajan", "value": "{{ instance.agents.disputeOrchestrator.agent }}" },
            { "label": "Analiz Zamanı", "value": "{{ instance.agents.disputeOrchestrator.evaluatedAt }}", "format": "g" }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "MCP (Model Context Protocol) Politika ve İşyeri Mutabakatı",
      "visibleWhen": "instance.agents != null && (instance.agents.readChargebackPolicy != null || instance.agents.verifyMerchantReceipt != null)",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "MCP Politika Versiyonu", "value": "{{ instance.agents.readChargebackPolicy.policyVersion }}", "visibleWhen": "instance.agents.readChargebackPolicy != null" },
            { "label": "Otomatik İade Limiti", "value": "{{ instance.agents.readChargebackPolicy.autoApproveLimit }}", "format": "N2", "visibleWhen": "instance.agents.readChargebackPolicy != null" },
            { "label": "Fraud Eskalasyon Limiti", "value": "{{ instance.agents.readChargebackPolicy.fraudEscalationLimit }}", "format": "N2", "visibleWhen": "instance.agents.readChargebackPolicy != null" },
            { "label": "MCP Provizyon Durumu", "value": "{{ instance.agents.verifyMerchantReceipt.settlementStatus }}", "visibleWhen": "instance.agents.verifyMerchantReceipt != null" },
            { "label": "MCP İade Edilebilir Tutar", "value": "{{ instance.agents.verifyMerchantReceipt.refundableAmount }}", "format": "N2", "visibleWhen": "instance.agents.verifyMerchantReceipt != null" },
            { "label": "Geçmiş İtiraz Sayısı", "value": "{{ instance.agents.lookupChargebackHistory.priorDisputes }}", "visibleWhen": "instance.agents.lookupChargebackHistory != null" },
            { "label": "İşyeri Risk Sınıfı", "value": "{{ instance.agents.lookupChargebackHistory.merchantRisk }}", "visibleWhen": "instance.agents.lookupChargebackHistory != null" }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "Çağrılan AI Araçları (Function / MCP Tool Calls)",
      "visibleWhen": "instance.toolCalls != null && instance.toolCalls.Count > 0",
      "children": [
        {
          "widget": "list",
          "source": "instance.toolCalls",
          "children": [
            {
              "widget": "fields",
              "items": [
                { "label": "Ajan / Sunucu", "value": "{{ row.agent }}", "visibleWhen": "row.agent != null" },
                { "label": "Araç Adı", "value": "{{ row.name }}" },
                { "label": "Çağrı No", "value": "{{ row.callId }}" },
                { "label": "Yönlendirme Kararı", "value": "{{ row.result.nextTransition }}", "visibleWhen": "row.result != null && row.result.nextTransition != null" },
                { "label": "Politika Kodu", "value": "{{ row.result.policyCode }}", "visibleWhen": "row.result != null && row.result.policyCode != null" },
                { "label": "Mutabakat Durumu", "value": "{{ row.result.settlementStatus }}", "visibleWhen": "row.result != null && row.result.settlementStatus != null" },
                { "label": "Hız Skoru", "value": "{{ row.result.velocityScore }}", "visibleWhen": "row.result != null && row.result.velocityScore != null" }
              ]
            }
          ]
        },
        {
          "widget": "timeline",
          "source": "instance.toolCalls",
          "title": "{{ row.name }} ({{ row.agent }})",
          "subtitle": "Çağrı ID: {{ row.callId }}",
          "time": "Adım #{{ row.rowNumber }}",
          "color": "info"
        }
      ]
    },
    {
      "widget": "section",
      "title": "AI Copilot Uzman Değerlendirmesi",
      "visibleWhen": "instance.agents != null && instance.agents.disputeSpecialistCopilot != null",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "Uzman Notu", "value": "{{ data.lastSpecialistNote }}", "visibleWhen": "data.lastSpecialistNote != null" },
            { "label": "Copilot Görüşü", "value": "{{ instance.agents.disputeSpecialistCopilot.copilotVerdict }}" },
            { "label": "Hesaplanan İade Tutarı", "value": "{{ instance.agents.disputeSpecialistCopilot.approvedRefundAmount }}", "format": "N2" },
            { "label": "Toplam Alacak Kaydı", "value": "{{ instance.agents.disputeSpecialistCopilot.totalCredit }}", "format": "N2" },
            { "label": "Politika Kodu", "value": "{{ instance.agents.disputeSpecialistCopilot.policyCode }}" }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "AI Çoklu Ajan (Multi-Agent) Fraud Komitesi Raporu",
      "visibleWhen": "instance.agents != null && instance.agents.fraudCommittee != null",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "Orkestratör Kararı", "value": "{{ instance.agents.fraudCommittee.decision }}" },
            { "label": "Risk Seviyesi", "value": "{{ instance.agents.fraudCommittee.riskLevel }}" },
            { "label": "Copilot Görüşü", "value": "{{ instance.agents.fraudCommittee.copilotVerdict }}", "visibleWhen": "instance.agents.fraudCommittee.copilotVerdict != null" },
            { "label": "Komite Gerekçesi", "value": "{{ instance.agents.fraudCommittee.rationale }}", "visibleWhen": "instance.agents.fraudCommittee.rationale != null" },
            { "label": "Çalışma Modu", "value": "{{ instance.agents.fraudCommittee.mode }}" }
          ]
        }
      ]
    },
    { "widget": "layout", "key": "workflow-footer" }
  ]
}
