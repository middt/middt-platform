{
  "key": "invoice-collection",
  "version": 1,
  "title": "Fatura Tahsilatı",
  "icon": "receipt_long",
  "history": "delta",
  "historySnapshotEvery": 10,
  "dataSchema": {
    "type": "object",
    "properties": {
      "invoiceNo": {
        "type": "string",
        "title": "Fatura No",
        "x-search": true
      },
      "customerName": {
        "type": "string",
        "title": "Müşteri Adı",
        "x-search": true
      },
      "total": {
        "type": "number",
        "title": "Fatura Tutarı (₺)",
        "x-search": true
      },
      "paidAmount": {
        "type": "number",
        "title": "Ödenen Tutar (₺)"
      },
      "remainingAmount": {
        "type": "number",
        "title": "Kalan Tutar (₺)"
      }
    }
  },
  "start": {
    "key": "start",
    "target": "awaiting-payment",
    "input": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoiceNo",
          "customerName",
          "total"
        ],
        "properties": {
          "invoiceNo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40,
            "title": "Fatura No",
            "default": "FTR-2026-0001"
          },
          "customerName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "title": "Müşteri Adı",
            "default": "Anadolu Lojistik A.Ş."
          },
          "total": {
            "type": "number",
            "minimum": 1,
            "title": "Fatura Tutarı (₺)",
            "default": 12500
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "title": "Açıklama",
            "default": "Ekim 2026 lojistik hizmet bedeli"
          }
        }
      },
      "set": {
        "paidAmount": "0",
        "remainingAmount": "input.total",
        "createdBy": "user.Name",
        "createdAt": "now"
      }
    }
  },
  "states": [
    {
      "key": "awaiting-payment",
      "title": "Ödeme Bekleniyor",
      "view": {
        "layout": "invoice-detail"
      },
      "step": 1,
      "onEntry": [
        {
          "task": "setKey",
          "config": {
            "key": "INV-{{ data.invoiceNo }}",
            "ensureUnique": true
          }
        }
      ],
      "transitions": [
        {
          "key": "payment-completed",
          "title": "Ödeme Tamamlandı",
          "target": "reconciling",
          "trigger": "Automatic",
          "rule": "data.paidAmount >= data.total"
        },
        {
          "key": "payment-received",
          "title": "Ödeme Alındı",
          "target": "$self",
          "trigger": "Event",
          "event": "payment.received",
          "rule": "data.remainingAmount > 0",
          "input": {
            "rule": "input.amount <= data.remainingAmount",
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Ödenen Tutar (₺)"
                },
                "reference": {
                  "type": "string",
                  "maxLength": 60,
                  "title": "Banka Referansı"
                }
              }
            },
            "into": "partialPayment[]",
            "set": {
              "paidAmount": "data.paidAmount + input.amount",
              "remainingAmount": "data.total > data.paidAmount ? data.total - data.paidAmount : 0",
              "partialPayment[-1].reference": "input.reference ?? \"BANKA-EFT\"",
              "partialPayment[-1].paidAt": "now",
              "payment.amount": "data.paidAmount",
              "payment.reference": "data.partialPayment.Last(\"reference\")"
            }
          }
        },
        {
          "key": "record-payment",
          "title": "Ödeme Kaydet",
          "target": "$self",
          "roles": [
            "manager"
          ],
          "rule": "data.remainingAmount > 0",
          "input": {
            "rule": "input.amount <= data.remainingAmount",
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Ödenen Tutar (₺)",
                  "default": 5000
                },
                "reference": {
                  "type": "string",
                  "maxLength": 60,
                  "title": "Banka Referansı",
                  "default": "EFT-2026-000{{ data.partialPayment != null ? data.partialPayment.Count + 1 : 1 }}"
                }
              }
            },
            "into": "partialPayment[]",
            "set": {
              "paidAmount": "data.paidAmount + input.amount",
              "remainingAmount": "data.total > data.paidAmount ? data.total - data.paidAmount : 0",
              "partialPayment[-1].reference": "input.reference ?? \"EFT-2026-0001\"",
              "partialPayment[-1].paidAt": "now",
              "partialPayment[-1].recordedBy": "user.Name",
              "payment.amount": "data.paidAmount",
              "payment.reference": "data.partialPayment.Last(\"reference\")"
            }
          }
        },
        {
          "key": "update-billing-contact",
          "title": "Fatura İletişim Bilgilerini Güncelle",
          "target": "$self",
          "input": {
            "format": "jsonPatch",
            "into": "billingContact",
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "maxLength": 120,
                  "title": "E-posta"
                },
                "phone": {
                  "type": "string",
                  "maxLength": 20,
                  "title": "Telefon"
                },
                "address": {
                  "type": "string",
                  "maxLength": 300,
                  "title": "Fatura Adresi"
                }
              }
            },
            "set": {
              "contactUpdatedBy": "user.Name"
            }
          }
        },
        {
          "key": "mark-overdue",
          "title": "Vade Doldu",
          "target": "overdue",
          "trigger": "Scheduled",
          "after": "P7D"
        }
      ]
    },
    {
      "key": "overdue",
      "title": "Vadesi Geçti",
      "view": {
        "layout": "invoice-detail"
      },
      "step": 1,
      "subType": "Human",
      "transitions": [
        {
          "key": "late-payment-completed",
          "title": "Gecikmeli Ödeme Tamamlandı",
          "target": "reconciling",
          "trigger": "Automatic",
          "rule": "data.paidAmount >= data.total"
        },
        {
          "key": "late-payment-received",
          "title": "Gecikmeli Ödeme Alındı",
          "target": "$self",
          "trigger": "Event",
          "event": "payment.received",
          "rule": "data.remainingAmount > 0",
          "input": {
            "rule": "input.amount <= data.remainingAmount",
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Ödenen Tutar (₺)"
                },
                "reference": {
                  "type": "string",
                  "maxLength": 60,
                  "title": "Banka Referansı"
                }
              }
            },
            "into": "partialPayment[]",
            "set": {
              "paidAmount": "data.paidAmount + input.amount",
              "remainingAmount": "data.total > data.paidAmount ? data.total - data.paidAmount : 0",
              "partialPayment[-1].reference": "input.reference ?? \"BANKA-EFT\"",
              "partialPayment[-1].paidAt": "now",
              "payment.amount": "data.paidAmount",
              "payment.reference": "data.partialPayment.Last(\"reference\")"
            }
          }
        },
        {
          "key": "record-late-payment",
          "title": "Gecikmeli Ödeme Kaydet",
          "target": "$self",
          "roles": [
            "manager"
          ],
          "rule": "data.remainingAmount > 0",
          "input": {
            "rule": "input.amount <= data.remainingAmount",
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "title": "Ödenen Tutar (₺)",
                  "default": 5000
                },
                "reference": {
                  "type": "string",
                  "maxLength": 60,
                  "title": "Banka Referansı",
                  "default": "EFT-2026-000{{ data.partialPayment != null ? data.partialPayment.Count + 1 : 1 }}"
                }
              }
            },
            "into": "partialPayment[]",
            "set": {
              "paidAmount": "data.paidAmount + input.amount",
              "remainingAmount": "data.total > data.paidAmount ? data.total - data.paidAmount : 0",
              "partialPayment[-1].reference": "input.reference ?? \"EFT-2026-0001\"",
              "partialPayment[-1].paidAt": "now",
              "partialPayment[-1].recordedBy": "user.Name",
              "payment.amount": "data.paidAmount",
              "payment.reference": "data.partialPayment.Last(\"reference\")"
            }
          }
        }
      ]
    },
    {
      "key": "reconciling",
      "title": "Muhasebe Mutabakatı (Arka Plan)",
      "view": {
        "layout": "invoice-detail"
      },
      "step": 2,
      "onEntry": [
        {
          "key": "post-ledger",
          "task": "http",
          "background": true,
          "onError": {
            "maxAttempts": 3,
            "delay": "00:00:02",
            "backoffMultiplier": 2.0,
            "retryOnStatusCodes": [
              "408",
              "429",
              "5xx"
            ],
            "action": "Transition",
            "transition": "reconcile-manually"
          },
          "config": {
            "method": "POST",
            "url": "http://mockoon:3000/api/v1/InvoiceCollection/ping",
            "body": {
              "invoiceNo": "{{ data.invoiceNo }}",
              "amount": "{{ data.payment.amount }}",
              "reference": "{{ data.payment.reference }}"
            },
            "select": [
              "body.referenceCode",
              "body.status",
              "statusCode"
            ],
            "into": "ledgerResponse"
          }
        },
        {
          "task": "set",
          "config": {
            "values": {
              "reconciledAt": "now"
            }
          }
        }
      ],
      "transitions": [
        {
          "key": "reconciled",
          "target": "paid",
          "trigger": "Automatic",
          "default": true
        },
        {
          "key": "reconcile-manually",
          "title": "Elle Mutabakata Gönder",
          "target": "manual-reconciliation",
          "roles": [
            "manager"
          ]
        }
      ]
    },
    {
      "key": "manual-reconciliation",
      "title": "Elle Mutabakat",
      "view": {
        "layout": "invoice-detail"
      },
      "step": 2,
      "subType": "Human",
      "transitions": [
        {
          "key": "confirm-reconciliation",
          "title": "Mutabakatı Onayla",
          "target": "paid",
          "roles": [
            "manager"
          ],
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note": {
                  "type": "string",
                  "maxLength": 300,
                  "title": "Mutabakat Notu",
                  "default": "Muhasebe kaydı elle girildi."
                }
              }
            },
            "into": "manualReconciliation",
            "set": {
              "reconciledBy": "user.Name",
              "reconciledAt": "now"
            }
          }
        }
      ]
    },
    {
      "key": "paid",
      "title": "Tahsil Edildi",
      "view": {
        "layout": "invoice-result"
      },
      "step": 3,
      "type": "Finish",
      "subType": "Success"
    },
    {
      "key": "cancelled",
      "title": "İptal Edildi",
      "view": {
        "layout": "invoice-result"
      },
      "step": 3,
      "type": "Finish",
      "subType": "Cancelled"
    }
  ],
  "sharedTransitions": [
    {
      "key": "delete-payment",
      "title": "Ödeme Kaydını Sil",
      "target": "$self",
      "style": "danger",
      "icon": "delete",
      "roles": [
        "manager"
      ],
      "rule": "data.paidAmount > 0 && data.partialPayment != null && data.partialPayment.Count > 0",
      "input": {
        "rule": "data.partialPayment.Any(\"reference\", input.reference)",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "title": "Silinecek Ödeme",
              "x-enumFrom": {
                "source": "partialPayment",
                "format": "#{{ item.rowNumber }} - {{ item.amount }} ₺ ({{ item.reference }})"
              }
            },
            "reason": {
              "type": "string",
              "maxLength": 300,
              "title": "Silme Nedeni",
              "default": "Hatalı ödeme kaydı düzeltildi."
            }
          }
        },
        "set": {
          "partialPayment": "data.partialPayment.Remove(\"reference\", input.reference)",
          "deletedPayment[]": "input.removed.With(\"reason\", input.reason ?? \"Hatalı ödeme kaydı düzeltildi.\").With(\"deletedBy\", user.Name).With(\"deletedAt\", now)",
          "paidAmount": "data.partialPayment.Sum(\"amount\")",
          "remainingAmount": "data.total > data.paidAmount ? data.total - data.paidAmount : 0",
          "payment.amount": "data.paidAmount",
          "payment.reference": "data.partialPayment.Last(\"reference\")"
        }
      },
      "availableIn": [
        "awaiting-payment",
        "overdue"
      ]
    },
    {
      "key": "patch-payment",
      "title": "Ödeme Kaydını Sil / Düzenle (JSON Patch)",
      "target": "$self",
      "style": "warning",
      "icon": "edit_note",
      "toolbar": false,
      "roles": [
        "manager"
      ],
      "rule": "data.paidAmount > 0 && data.partialPayment != null && data.partialPayment.Count > 0",
      "input": {
        "format": "jsonPatch",
        "into": "partialPayment",
        "rule": "data.partialPayment.Sum(\"amount\") <= data.total",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "reference": {
                "type": "string",
                "maxLength": 60
              },
              "paidAt": {
                "type": "string"
              },
              "recordedBy": {
                "type": "string"
              }
            }
          }
        },
        "set": {
          "deletedPayment[]": "input.removed.With(\"reason\", input.reason ?? \"JSON Patch ile silindi.\").With(\"deletedBy\", user.Name).With(\"deletedAt\", now)",
          "paidAmount": "data.partialPayment.Sum(\"amount\")",
          "remainingAmount": "data.total > data.paidAmount ? data.total - data.paidAmount : 0",
          "payment.amount": "data.paidAmount",
          "payment.reference": "data.partialPayment.Last(\"reference\")"
        }
      },
      "availableIn": [
        "awaiting-payment",
        "overdue"
      ]
    },
    {
      "key": "cancel-invoice",
      "title": "Faturayı İptal Et",
      "target": "cancelled",
      "roles": [
        "manager"
      ],
      "input": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "title": "İptal Nedeni",
              "default": "Fatura müşteri talebiyle iptal edildi."
            }
          }
        },
        "into": "cancellation"
      },
      "availableIn": [
        "awaiting-payment",
        "overdue"
      ]
    },
    {
      "key": "ai-risk-audit",
      "title": "AI Risk Analizi",
      "target": "$self",
      "style": "secondary",
      "icon": "psychology",
      "availableIn": [
        "awaiting-payment",
        "overdue"
      ],
      "roles": [
        "manager"
      ],
      "onExecute": [
        {
          "key": "run-risk-auditor-agent",
          "task": "agent",
          "config": {
            "agent": "invoice-risk-auditor",
            "prompt": "Fatura {{ data.invoiceNo }} ({{ data.customerName }}) için tahsilat ve ödeme silme geçmişini analiz et.",
            "context": {
              "invoiceNo": "{{ data.invoiceNo }}",
              "customerName": "{{ data.customerName }}",
              "total": "{{ data.total }}",
              "paidAmount": "{{ data.paidAmount }}",
              "remainingAmount": "{{ data.remainingAmount }}",
              "partialPayment": "{{ data.partialPayment }}",
              "deletedPayment": "{{ data.deletedPayment }}"
            }
          }
        }
      ]
    }
  ]
}
