{
  "key": "risk-limit-eval",
  "version": 1,
  "title": "Risk & Limit Değerlendirme Servisi",
  "icon": "verified_user",
  "dataSchema": {
    "type": "object",
    "properties": {
      "customerKey": { "type": "string", "title": "Müşteri Anahtarı", "x-search": true },
      "checkType": {
        "type": "string",
        "title": "Kontrol Tipi",
        "enum": [
          "Kredi Tahsis Limit Kontrolü",
          "Kredi Limit Analizi",
          "Fraud Kontrolü",
          "Stok & Depo Kontrolü",
          "Limit & Uyum Kontrolü",
          "Genel Risk Kontrolü"
        ],
        "x-search": true
      },
      "amount": { "type": "number", "title": "Talep Edilen Tutar (₺)", "x-search": true },
      "riskScore": { "type": "integer", "title": "Risk Skoru", "x-search": true },
      "recommendedLimit": { "type": "number", "title": "Önerilen Limit (₺)" }
    }
  },
  "start": {
    "key": "start",
    "target": "evaluate",
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "customerKey": { "type": "string", "title": "Müşteri Anahtarı", "default": "CUST-12345678901" },
          "amount": { "type": "number", "minimum": 0, "title": "Talep Edilen Tutar (₺)", "default": 250000 },
          "checkType": { "type": "string", "title": "Kontrol Tipi", "default": "Kredi Limit Analizi" },
          "requireUnderwriting": { "type": "boolean", "title": "Yüksek Tutarda Uzman Onayı İste", "default": false }
        }
      }
    }
  },
  "states": [
    {
      "key": "evaluate",
      "title": "Otomatik Risk & Limit Analizi",
      "step": 1,
      "view": { "layout": "risk-detail" },
      "onEntry": [
        {
          "task": "set",
          "config": {
            "values": {
              "customerKey": "data.customerKey != null ? data.customerKey : \"CUST-GENEL\"",
              "amount": "data.amount != null ? data.amount : 100000",
              "checkType": "data.checkType != null ? data.checkType : \"Genel Risk Kontrolü\"",
              "requireUnderwriting": "data.requireUnderwriting ?? false",
              "recommendedLimit": "data.amount * 1.25",
              "evaluatedAt": "now"
            }
          }
        },
        {
          "task": "cache",
          "config": {
            "key": "risk-eval:{{ data.customerKey }}-{{ data.checkType }}",
            "ttl": "00:15:00",
            "into": "riskScore",
            "subTask": {
              "task": "set",
              "config": {
                "values": {
                  "riskScore": "data.amount > 500000 ? 640 : 810"
                }
              }
            }
          }
        },
        {
          "key": "ai-risk-limit-underwriter",
          "task": "agent",
          "config": {
            "agent": "risk-limit-underwriter",
            "prompt": "Müşteri {{ data.customerKey }} için {{ data.amount }} ₺ tutarındaki '{{ data.checkType }}' talebini KKB risk skoru, önceki ödeme performansı, sektörel limit kullanımı ve teminat araçlarını çağırarak analiz et ve akış yönlendirmesini belirle.",
            "context": {
              "customerKey": "{{ data.customerKey }}",
              "amount": "{{ data.amount }}",
              "checkType": "{{ data.checkType }}",
              "requireUnderwriting": "{{ data.requireUnderwriting }}"
            }
          }
        },
        {
          "task": "log",
          "config": {
            "level": "Information",
            "message": "Risk değerlendirmesi çalıştı: {{ data.checkType }}, Tutar={{ data.amount }}, Skor={{ data.riskScore }}"
          }
        }
      ],
      "transitions": [
        {
          "key": "to-underwriting",
          "title": "AI Tahsis Uzmanı Yönlendirmesi",
          "description": "500.000 ₺ üzerindeki ve uzman incelemesi (requireUnderwriting) talep edilen başvuruları tahsis uzmanı onayına yönlendirir.",
          "target": "manual-underwriting",
          "trigger": "Automatic",
          "rule": "data.requireUnderwriting == true && data.amount > 500000"
        },
        {
          "key": "to-rejected",
          "title": "AI Otomatik Limit Reddi",
          "description": "5.000.000 ₺ üst limiti aşan veya yüksek temerrüt/sektör riski taşıyan başvuruları otomatik olarak reddeder.",
          "target": "rejected",
          "trigger": "Automatic",
          "rule": "data.amount > 5000000",
          "onExecute": [
            {
              "task": "set",
              "config": {
                "values": {
                  "reason": "instance.agents.riskLimitUnderwriter.summary ?? \"Kurum üst limit ve risk kriterleri aşıldı.\""
                }
              }
            }
          ]
        },
        {
          "key": "to-approved",
          "title": "AI Otomatik Limit Onayı",
          "description": "Risk skoru, önceki ödeme performansı ve teminat rasyoları uygun olan standart başvuruları otomatik onaylar.",
          "target": "approved",
          "trigger": "Automatic",
          "default": true
        }
      ]
    },
    {
      "key": "manual-underwriting",
      "title": "Tahsis Uzmanı İncelemesi (Alt Akış)",
      "step": 2,
      "subType": "Human",
      "view": { "layout": "risk-detail" },
      "transitions": [
        {
          "key": "ai-underwriting-recheck",
          "title": "AI Derinlemesine Risk & Ödeme Analizi",
          "description": "Müşterinin KKB skorunu, geçmiş ödeme performansını ve sektörel limit kullanımını AI ajanıyla yeniden sorgular.",
          "target": "$self",
          "style": "primary",
          "icon": "smart_toy",
          "onExecute": [
            {
              "key": "ai-risk-limit-underwriter",
              "task": "agent",
              "config": {
                "agent": "risk-limit-underwriter",
                "prompt": "Tahsis uzmanı incelemesindeki {{ data.customerKey }} müşterisinin {{ data.amount }} ₺ tutarındaki '{{ data.checkType }}' talebi için güncel KKB risk skorunu, önceki ödeme performansını ve sektörel teminat marjını yeniden değerlendir.",
                "context": {
                  "customerKey": "{{ data.customerKey }}",
                  "amount": "{{ data.amount }}",
                  "checkType": "{{ data.checkType }}",
                  "requireUnderwriting": "{{ data.requireUnderwriting }}"
                }
              }
            }
          ]
        },
        {
          "key": "approve-underwriting",
          "title": "Alt Akış Limitini Onayla",
          "target": "approved",
          "roles": [ "manager" ],
          "view": { "inline": true },
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "underwriterNote": { "type": "string", "maxLength": 300, "title": "Tahsis Uzmanı Notu", "default": "Tahsis uzmanı incelemesi olumlu." }
              }
            },
            "set": {
              "underwrittenBy": "user.Name",
              "underwrittenAt": "now"
            }
          }
        },
        {
          "key": "reject-underwriting",
          "title": "Alt Akış Limitini Reddet",
          "target": "rejected",
          "roles": [ "manager" ],
          "input": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "reason" ],
              "properties": {
                "reason": { "type": "string", "minLength": 3, "maxLength": 300, "title": "Red Nedeni", "default": "Risk skoru ve limit kriterleri sağlanamadı." }
              }
            },
            "set": {
              "underwrittenBy": "user.Name",
              "underwrittenAt": "now"
            }
          }
        }
      ]
    },
    {
      "key": "approved",
      "title": "Risk Onaylandı",
      "step": 3,
      "type": "Finish",
      "subType": "Success",
      "view": { "layout": "risk-detail" }
    },
    {
      "key": "rejected",
      "title": "Risk Reddedildi",
      "step": 3,
      "type": "Finish",
      "subType": "Error",
      "view": { "layout": "risk-detail" }
    }
  ]
}
