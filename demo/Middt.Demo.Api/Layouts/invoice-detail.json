{
  "$schema": "../../../spec/ui-layout.schema.json",
  "key": "invoice-detail",
  "title": "Fatura Tahsilat Durumu",
  "kind": "view",
  "version": 8,
  "body": [
    {
      "widget": "alert",
      "severity": "info",
      "text": "Ödeme bekleniyor. Banka ödeme bildirimi \"payment.received\" mesajı olarak geldiğinde fatura otomatik ilerler.",
      "visibleWhen": "instance.state == \"awaiting-payment\""
    },
    {
      "widget": "alert",
      "severity": "warning",
      "text": "Vade geçti. Gecikmeli ödeme mesajı geldiğinde mutabakat otomatik başlar.",
      "visibleWhen": "instance.state == \"overdue\""
    },
    {
      "widget": "alert",
      "severity": "info",
      "text": "Muhasebe kaydı arka planda yapılıyor; fatura bu sırada görüntülenebilir.",
      "visibleWhen": "instance.state == \"reconciling\""
    },
    {
      "widget": "alert",
      "severity": "warning",
      "text": "Muhasebe servisi kaydı alamadı; mutabakatı elle onaylayın.",
      "visibleWhen": "instance.state == \"manual-reconciliation\""
    },
    {
      "widget": "section",
      "title": "Fatura Bilgileri",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "Fatura No", "value": "{{ data.invoiceNo }}" },
            { "label": "Müşteri", "value": "{{ data.customerName }}" },
            { "label": "Fatura Tutarı", "value": "{{ data.total }}", "format": "N2" },
            { "label": "Toplam Ödenen", "value": "{{ data.paidAmount }}", "format": "N2", "visibleWhen": "data.paidAmount != null && data.paidAmount > 0" },
            { "label": "Kalan Tutar", "value": "{{ data.remainingAmount }}", "format": "N2", "visibleWhen": "data.remainingAmount != null && data.remainingAmount > 0" },
            { "label": "Açıklama", "value": "{{ data.description }}", "visibleWhen": "data.description != null" },
            { "label": "Ödenen Tutar", "value": "{{ data.payment.amount }}", "format": "N2", "visibleWhen": "data.payment != null && data.payment.amount > 0" },
            { "label": "Banka Referansı", "value": "{{ data.payment.reference }}", "visibleWhen": "data.payment != null && data.payment.reference != null" }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "Kısmi Ödemeler",
      "visibleWhen": "data.partialPayment != null && data.partialPayment.Count > 0",
      "children": [
        {
          "widget": "list",
          "source": "data.partialPayment",
          "rowTransitions": [
            {
              "key": "delete-payment",
              "text": "Sil (Kayıtlı)",
              "icon": "delete",
              "style": "danger",
              "input": {
                "reference": "#{{ row.rowNumber }} - {{ row.amount }} ₺ ({{ row.reference }})",
                "reason": "Hatalı kısmi ödeme satırı silindi."
              }
            },
            {
              "key": "patch-payment",
              "text": "Sil (JSON Patch)",
              "icon": "delete_sweep",
              "style": "warning",
              "input": {
                "patch": [
                  { "op": "test", "path": "/{{ row.rowNumber - 1 }}/reference", "value": "{{ row.reference }}" },
                  { "op": "remove", "path": "/{{ row.rowNumber - 1 }}" }
                ]
              }
            }
          ],
          "children": [
            {
              "widget": "fields",
              "items": [
                { "label": "Ödeme No", "value": "#{{ row.rowNumber }}", "visibleWhen": "row.rowNumber != null" },
                { "label": "Ödenen Tutar", "value": "{{ row.amount }}", "format": "N2" },
                { "label": "Banka Referansı", "value": "{{ row.reference }}", "visibleWhen": "row.reference != null" },
                { "label": "Kaydeden", "value": "{{ row.recordedBy }}", "visibleWhen": "row.recordedBy != null" },
                { "label": "Ödeme Zamanı", "value": "{{ row.paidAt }}", "format": "g", "visibleWhen": "row.paidAt != null" }
              ]
            }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "Silinen Ödemeler",
      "visibleWhen": "data.deletedPayment != null && data.deletedPayment.Count > 0",
      "children": [
        {
          "widget": "list",
          "source": "data.deletedPayment",
          "children": [
            {
              "widget": "fields",
              "items": [
                { "label": "Silinen Ödeme", "value": "{{ row.reference }}" },
                { "label": "Tutar", "value": "{{ row.amount }}", "format": "N2", "visibleWhen": "row.amount != null" },
                { "label": "Silme Nedeni", "value": "{{ row.reason }}", "visibleWhen": "row.reason != null" },
                { "label": "Silen Kullanıcı", "value": "{{ row.deletedBy }}", "visibleWhen": "row.deletedBy != null" },
                { "label": "Silinme Zamanı", "value": "{{ row.deletedAt }}", "format": "g", "visibleWhen": "row.deletedAt != null" }
              ]
            }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "AI Risk Analizi",
      "visibleWhen": "data.aiAudit != null",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "Risk Seviyesi", "value": "{{ data.aiAudit.riskLevel }}", "visibleWhen": "data.aiAudit.riskLevel != null" },
            { "label": "Risk Skoru", "value": "{{ data.aiAudit.score }}", "visibleWhen": "data.aiAudit.score != null" },
            { "label": "Analiz Özeti", "value": "{{ data.aiAudit.summary }}", "visibleWhen": "data.aiAudit.summary != null" },
            { "label": "Öneri", "value": "{{ data.aiAudit.recommendation }}", "visibleWhen": "data.aiAudit.recommendation != null" },
            { "label": "Ajan", "value": "{{ data.aiAudit.meta.agent }}", "visibleWhen": "data.aiAudit.meta != null && data.aiAudit.meta.agent != null" },
            { "label": "Analiz Zamanı", "value": "{{ data.aiAudit.meta.evaluatedAt }}", "format": "g", "visibleWhen": "data.aiAudit.meta != null && data.aiAudit.meta.evaluatedAt != null" }
          ]
        }
      ]
    },
    {
      "widget": "section",
      "title": "Fatura İletişim Bilgileri",
      "visibleWhen": "data.billingContact != null",
      "children": [
        {
          "widget": "fields",
          "items": [
            { "label": "E-posta", "value": "{{ data.billingContact.email }}", "visibleWhen": "data.billingContact.email != null" },
            { "label": "Telefon", "value": "{{ data.billingContact.phone }}", "visibleWhen": "data.billingContact.phone != null" },
            { "label": "Fatura Adresi", "value": "{{ data.billingContact.address }}", "visibleWhen": "data.billingContact.address != null" },
            { "label": "Son Güncelleyen", "value": "{{ data.contactUpdatedBy }}", "visibleWhen": "data.contactUpdatedBy != null" }
          ]
        }
      ]
    },
    { "widget": "layout", "key": "workflow-footer" }
  ]
}
