{
  "name": "calculate_reimbursement",
  "kind": "expression",
  "description": "İade tutarı, masraf iadesi ve uygulanacak politika kodunu hesaplar.",
  "parameters": {
    "type": "object",
    "properties": {
      "amount": { "type": "number" },
      "category": { "type": "string" }
    }
  },
  "output": {
    "approvedRefundAmount": "{{ args.amount }}",
    "feeReversal": "{{ args.amount <= 5000 ? 0 : 150 }}",
    "totalCredit": "{{ args.amount + (args.amount <= 5000 ? 0 : 150) }}",
    "policyCode": "{{ args.amount <= 5000 ? \"CB-FAST-2026\" : \"CB-STD-2026\" }}"
  }
}
