{
  "name": "calculate_reimbursement",
  "kind": "task",
  "task": "set",
  "description": "İade tutarı, masraf iadesi ve uygulanacak politika kodunu workflow 'set' task'ı üzerinden hesaplar.",
  "parameters": {
    "type": "object",
    "properties": {
      "amount": { "type": "number" },
      "category": { "type": "string" }
    }
  },
  "into": "reimbursement",
  "config": {
    "values": {
      "reimbursement.approvedRefundAmount": "args.amount",
      "reimbursement.feeReversal": "args.amount <= 5000 ? 0 : 150",
      "reimbursement.totalCredit": "args.amount + (args.amount <= 5000 ? 0 : 150)",
      "reimbursement.policyCode": "args.amount <= 5000 ? \"CB-FAST-2026\" : \"CB-STD-2026\""
    }
  }
}
